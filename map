                                pcall(function()
                                    if not child.Parent then return end
                                    local hide = getgenv().MapAutoConfig and getgenv().MapAutoConfig.HideBreakables
                                    for _, desc in ipairs(child:GetDescendants()) do
                                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Highlight") or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") then
                                            pcall(function() desc:Destroy() end)
                                        elseif desc:IsA("BillboardGui") then
                                            pcall(function() desc.Enabled = false end)
                                        elseif desc:IsA("Decal") or desc:IsA("Texture") then
                                            if hide then
                                                pcall(function() desc.Transparency = 1 end)
                                            else
                                                pcall(function() desc:Destroy() end)
                                            end
                                        elseif desc:IsA("BasePart") or desc:IsA("MeshPart") or desc:IsA("UnionOperation") then
                                            if hide then
                                                desc.Transparency = 1
                                                desc.CastShadow = false
                                            else
                                                desc.Material = Enum.Material.SmoothPlastic
                                                desc.CastShadow = false
                                            end
                                        end
                                    end
                                end)
                            end)
                        end
                        AddConnection(breakablesFolder.ChildAdded:Connect(CleanBreakable))
                        for _, child in ipairs(breakablesFolder:GetChildren()) do
                            CleanBreakable(child)
                        end
                    end

                    local petsFolder = thingsFolder:FindFirstChild("Pets")
                    if petsFolder then
                        local function CleanPet(child)
                            if not child then return end
                            task.defer(function()
                                pcall(function()
                                    if not child.Parent then return end
                                    local hide = getgenv().MapAutoConfig and getgenv().MapAutoConfig.HidePets
                                    for _, desc in ipairs(child:GetDescendants()) do
                                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Highlight") or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
                                            pcall(function() desc.Enabled = false end)
                                        elseif desc:IsA("BillboardGui") then
                                            pcall(function() desc.Enabled = false end)
                                        elseif desc:IsA("Decal") or desc:IsA("Texture") then
                                            if hide then
                                                pcall(function() desc.Transparency = 1 end)
                                            end
                                        elseif desc:IsA("BasePart") or desc:IsA("MeshPart") or desc:IsA("UnionOperation") then
                                            if hide then
                                                desc.Transparency = 1
                                                desc.CastShadow = false
                                            else
                                                desc.Material = Enum.Material.SmoothPlastic
                                                desc.CastShadow = false
                                            end
                                        end
                                    end
                                end)
                            end)
                        end
                        AddConnection(petsFolder.ChildAdded:Connect(CleanPet))
                        for _, child in ipairs(petsFolder:GetChildren()) do
                            CleanPet(child)
                        end
                    end

                    if getgenv().MapAutoConfig and getgenv().MapAutoConfig.HideBreakableHealth then
                        pcall(function()
                            local assetsFolder = ReplicatedStorage:FindFirstChild("Assets")
                            local billboardsFolder = assetsFolder and assetsFolder:FindFirstChild("Billboards")
                            if billboardsFolder then
                                for _, bName in ipairs({ "BreakableProgress", "Damage", "BreakableProgressOLD", "BreakableModifier" }) do
                                    local bTemplate = billboardsFolder:FindFirstChild(bName)
                                    if bTemplate and bTemplate:IsA("BillboardGui") then
                                        bTemplate.Enabled = false
                                    end
                                end
                            end

                            local debrisFolder = workspace:FindFirstChild("__DEBRIS")
                            if debrisFolder then
                                local function DisableDebrisNode(node)
                                    if node:IsA("BillboardGui") or node:IsA("ParticleEmitter") or node:IsA("Beam") or node:IsA("Trail") then
                                        node.Enabled = false
                                    end
                                end
                                local function CleanDebrisChild(inst)
                                    if not inst then return end
                                    task.defer(function()
                                        pcall(function()
                                            if not inst.Parent then return end
                                            DisableDebrisNode(inst)
                                            for _, desc in ipairs(inst:GetDescendants()) do
                                                DisableDebrisNode(desc)
                                            end
                                        end)
                                    end)
                                end
                                AddConnection(debrisFolder.ChildAdded:Connect(CleanDebrisChild))
                                for _, child in ipairs(debrisFolder:GetChildren()) do
                                    CleanDebrisChild(child)
                                end
                            end
                        end)
                    end
                end

                local FLAT_GRAY_COLOR = Color3.fromRGB(160, 160, 160)
                local currentOptiMode = tonumber(getgenv().MapAutoConfig and getgenv().MapAutoConfig.opti_mode) or 2
                local strongMode = (currentOptiMode == 1)

                local INTERACT_KEEP_PATTERNS = {
                    "ZONEQUEST", "VIP GATE", "MACHINES", "BREAKABLE_SPAWNS",
                    "BREAK_ZONES", "BREAK_ZONE", "UPGRADES", "TELEPORT",
                }
                local function ShouldKeepInteractChild(name)
                    local n = string.upper(tostring(name))
                    for _, pat in ipairs(INTERACT_KEEP_PATTERNS) do
                        if string.find(n, pat, 1, true) then return true end
                    end
                    return false
                end

                local function StripPartVisuals(desc)
                    if not desc or not desc.Parent then return end
                    if desc:IsA("BasePart") then
                        desc.Material = Enum.Material.SmoothPlastic
                        desc.Color = FLAT_GRAY_COLOR
                        desc.CastShadow = false
                        desc.Reflectance = 0
                        if desc:IsA("MeshPart") then
                            pcall(function() desc.TextureID = "" end)
                        end
                    elseif desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Decal") or desc:IsA("Texture")
                        or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight")
                        or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire")
                        or desc:IsA("Highlight") or desc:IsA("SurfaceAppearance") then
                        pcall(function() desc:Destroy() end)
                    elseif desc:IsA("SpecialMesh") then
                        desc.TextureId = ""
                    end
                end

                local function OptimizeZoneFolder(zoneFolder)
                    if not zoneFolder or not zoneFolder.Parent then return end
                    pcall(function()
                        for _, sub in ipairs(zoneFolder:GetChildren()) do
                            local subName = sub.Name
                            if strongMode and (subName == "PARTS_LOD" or subName == "PARTS") then
                                for _, partChild in ipairs(sub:GetChildren()) do
                                    if string.upper(partChild.Name) ~= "GROUND" then
                                        pcall(function() partChild:Destroy() end)
                                    else
                                        StripPartVisuals(partChild)
                                        for _, d in ipairs(partChild:GetDescendants()) do
                                            StripPartVisuals(d)
                                        end
                                    end
                                end
                            elseif strongMode and subName == "INTERACT" then
                                for _, intChild in ipairs(sub:GetChildren()) do
                                    if not ShouldKeepInteractChild(intChild.Name) then
                                        pcall(function() intChild:Destroy() end)
                                    else
                                        StripPartVisuals(intChild)
                                        for _, d in ipairs(intChild:GetDescendants()) do
                                            StripPartVisuals(d)
                                        end
                                    end
                                end
                            else
                                StripPartVisuals(sub)
                                for _, d in ipairs(sub:GetDescendants()) do
                                    StripPartVisuals(d)
                                end
                            end
                        end
                    end)
                end

                local function HookZoneFolder(zoneFolder)
                    if not zoneFolder then return end
                    OptimizeZoneFolder(zoneFolder)
                    AddConnection(zoneFolder.ChildAdded:Connect(function()
                        task.defer(OptimizeZoneFolder, zoneFolder)
                    end))
                end

                for _, child in ipairs(workspace:GetChildren()) do
                    if string.find(string.lower(child.Name), "always_render", 1, true) then
                        pcall(function() child:ClearAllChildren() end)
                    end
                end

                pcall(function()
                    if settings and settings().Rendering then
                        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                    end
                end)

                pcall(function()
                    if workspace.Terrain then
                        workspace.Terrain.WaterWaveSize = 0
                        workspace.Terrain.WaterWaveSpeed = 0
                        workspace.Terrain.WaterReflectance = 0
                    end
                end)

                pcall(function()
                    local LightingMgr = LoadModule(Client, "LightingManager")
                    if LightingMgr and LightingMgr.SetLighting then
                        local rawSetLighting = LightingMgr.SetLighting
                        LightingMgr.SetLighting = function() end
                        RegisterPatch(LightingMgr, "SetLighting", rawSetLighting)
                    end
                end)

                local Lighting = game:GetService("Lighting")
                Lighting.GlobalShadows = false
                for _, v in ipairs(Lighting:GetChildren()) do
                    pcall(function()
                        if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                            or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") then
                            v:Destroy()
                        end
                    end)
                end
                AddConnection(Lighting.ChildAdded:Connect(function(v)
                    task.defer(function()
                        if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                            or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") then
                            pcall(function() v:Destroy() end)
                        end
                    end)
                end))

                task.spawn(function()
                    for _, wsChild in ipairs(workspace:GetChildren()) do
                        if wsChild.Name == "Map" or string.find(wsChild.Name, "^Map%d*$") then
                            AddConnection(wsChild.ChildAdded:Connect(function(newZone)
                                task.defer(HookZoneFolder, newZone)
                            end))
                            local zones = wsChild:GetChildren()
                            for idx, zoneFolder in ipairs(zones) do
                                if not Running() then return end
                                HookZoneFolder(zoneFolder)
                                if idx % 8 == 0 then
                                    task.wait()
                                end
                            end
                        elseif wsChild.Name == "Border" or wsChild.Name == "FlyBorder" then
                            for _, d in ipairs(wsChild:GetDescendants()) do
                                StripPartVisuals(d)
                            end
                        end
                    end
                end)

                if getgenv().MapAutoConfig.HideOrbs then
                    pcall(function()
                        local orbFolder = Client:FindFirstChild("OrbCmds")
                        local OrbModule = (orbFolder and orbFolder:FindFirstChild("Orb") and require(orbFolder.Orb))
                        if OrbModule and OrbModule.CreatePart then
                            local rawCreatePart = OrbModule.CreatePart
                            OrbModule.CreatePart = function(...)
                                local p, emitters, b, d = rawCreatePart(...)
                                if p and p:IsA("BasePart") then
                                    p.Transparency = 1
                                    p.LocalTransparencyModifier = 1
                                end
                                if emitters then
                                    for _, emitter in ipairs(emitters) do
                                        pcall(function() emitter.Enabled = false end)
                                    end
                                end
                                return p, emitters, b, d
                            end
                            RegisterPatch(OrbModule, "CreatePart", rawCreatePart)
                        end
                    end)
                end

                pcall(function()
                    pcall(function()
                        local UserSettingsService = UserSettings()
                        if UserSettingsService and UserSettingsService:GetService("UserGameSettings") then
                            UserSettingsService:GetService("UserGameSettings").MasterVolume = 0
                        end
                    end)
                    for _, sound in ipairs(game:GetService("SoundService"):GetDescendants()) do
                        if sound:IsA("Sound") then
                            sound.Volume = 0
                        end
                    end

                    local function OptimizePlayerCharacter(player)
                        if player == LocalPlayer or not player.Character then return end
                        pcall(function()
                            for _, desc in ipairs(player.Character:GetDescendants()) do
                                if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Highlight") or desc:IsA("BillboardGui") then
                                    desc:Destroy()
                                elseif desc:IsA("BasePart") then
                                    desc.CastShadow = false
                                    desc.CanCollide = false
                                    desc.CanTouch = false
                                    desc.CanQuery = false
                                end
                            end
                        end)
                    end

                    for _, p in ipairs(Players:GetPlayers()) do
                        OptimizePlayerCharacter(p)
                        AddConnection(p.CharacterAdded:Connect(function()
                            task.wait(0.5)
                            OptimizePlayerCharacter(p)
                        end))
                    end
                    AddConnection(Players.PlayerAdded:Connect(function(p)
                        AddConnection(p.CharacterAdded:Connect(function()
                            task.wait(0.5)
                            OptimizePlayerCharacter(p)
                        end))
                    end))

                    pcall(function()
                        if settings and settings().Physics then
                            settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.DefaultAuto
                        end
                    end)
                end)
            end)
        end)
    end)
end

local function FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e15 then return string.format("%.2fQ", n / 1e15)
    elseif n >= 1e12 then return string.format("%.2fT", n / 1e12)
    elseif n >= 1e9 then return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then return string.format("%.2fK", n / 1e3)
    else return tostring(math.floor(n)) end
end

local function FormatNumber(num)
    return FormatCompactNumber(num)
end

