local function ApplyFPSCap(targetFPS)
    targetFPS = tonumber(targetFPS)
    if not targetFPS or targetFPS <= 0 then return end
    pcall(function()
        local genv = (getgenv and getgenv()) or _G
        local fpsFunc = genv.setfpscap or genv.set_fps_cap or genv.setfps
        if typeof(fpsFunc) == "function" then
            fpsFunc(targetFPS)
        end
    end)
    pcall(function()
        if UserSettings then
            local ugs = UserSettings():GetService("UserGameSettings")
            ugs.TargetFramerate = targetFPS
        end
    end)
end

