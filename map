local function TrySpawnEventItem(key, remoteName, uid, label)
    if not uid or not remoteName then return false end
    local netFolder = ReplicatedStorage:FindFirstChild("Network")
    if netFolder and not netFolder:FindFirstChild(remoteName) then
        return false
    end
    local now = os.clock()
    local successWindow = 45
    local failCooldown = 10
    if now - (lastItemSpawnTime[key] or 0) <= successWindow and now < (lastSpawnRetryAt[key] or 0) then
        return false
    end
    local canSpawnHere = true
    pcall(function()
        local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
        local successInst, InstancingCmds = pcall(function() return LoadModule(Client, "InstancingCmds") end)
        if successMap and MapCmds then
            if not MapCmds.GetCurrentZone() or (MapCmds.IsInDottedBox and not MapCmds.IsInDottedBox()) then
                canSpawnHere = false
            end
        end
        if successInst and InstancingCmds and InstancingCmds.IsInInstance and InstancingCmds.IsInInstance() then
            canSpawnHere = false
        end
    end)
    if not canSpawnHere then
        return false
    end
    local ok, v1, v2 = pcall(function()
        return Network.Invoke(remoteName, uid)
    end)
    if ok and v1 then
        lastItemSpawnTime[key] = now
        lastSpawnRetryAt[key] = 0
        print(string.format("[MapAuto:Rank] Spawned '%s'", tostring(label)))
        return true
    end
    lastSpawnRetryAt[key] = now + failCooldown
    if now - (lastSpawnFailLog[key] or 0) > 30 then
        lastSpawnFailLog[key] = now
        print(string.format("[MapAuto:Rank] '%s' spawn busy (retry in %ds): %s", tostring(label), failCooldown, tostring(v2 or "area occupied")))
    end
    return false
end

local machineUIDFailTracker = {}

local function isBlacklisted(uid)
    if not uid then return false end
    local key = tostring(uid)
    local entry = machineUIDFailTracker[key]
    if not entry or entry.failCount < 2 then return false end
    if not entry.blacklistedAt then
        entry.blacklistedAt = os.clock()
    end
    if os.clock() - entry.blacklistedAt < 120 then
        return true
    else
        machineUIDFailTracker[key] = nil
        return false
    end
end

local currentlyCraftingPetUIDs = {}

local function FindPetUIDForMachine(machineType, isBestEggOnly, maxDesiredCrafts)
    local costPerPet = 10
    pcall(function()
        local MasteryCmds = LoadModule(Client, "MasteryCmds")
        if MasteryCmds and MasteryCmds.HasPerk and MasteryCmds.GetPerkPower then
            local perkName = (machineType == "Gold" and "GoldReduction") or "RainbowReduction"
            if MasteryCmds.HasPerk("Pets", perkName) then
                costPerPet = math.max(1, 10 - (MasteryCmds.GetPerkPower("Pets", perkName) or 0))
            end
        end
    end)

    local bestEggPetSet = nil
    if isBestEggOnly then
        bestEggPetSet = {}
        pcall(function()
            local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
            local zoneDef = Directory and Directory.Zones
                and (Directory.Zones[maxZoneName] or (maxZoneData and maxZoneData._id and Directory.Zones[maxZoneData._id]))
            local maxEggNum = (zoneDef and (zoneDef.MaximumAvailableEgg or zoneDef.maximumAvailableEgg)) or 1

            if Directory and Directory.Eggs then
                for _, eggData in pairs(Directory.Eggs) do
                    if eggData.eggNumber == maxEggNum and eggData.pets then
                        for _, petDrop in ipairs(eggData.pets) do
                            if petDrop and petDrop[1] then
                                bestEggPetSet[tostring(petDrop[1])] = true
                            end
                        end
                        break
                    end
                end
            end
        end)
    end

    local excludedUIDs = {}
    local saveData = Save.Get()
    if saveData then
        for _, slot in pairs(saveData.DaycareActive or {}) do
            local petUID = slot.Pet and (slot.Pet._id or slot.Pet._uid or slot.Pet.uid)
            if petUID then excludedUIDs[tostring(petUID)] = true end
        end
        for _, slot in pairs(saveData.ExclusiveDaycareActive or {}) do
            local petUID = slot.Pet and (slot.Pet._id or slot.Pet._uid or slot.Pet.uid)
            if petUID then excludedUIDs[tostring(petUID)] = true end
        end
        for eqKey, eqVal in pairs(saveData.EquippedPets or {}) do
            excludedUIDs[tostring(eqKey)] = true
            if type(eqVal) == "string" or type(eqVal) == "number" then
                excludedUIDs[tostring(eqVal)] = true
            elseif type(eqVal) == "table" and (eqVal.uid or eqVal._uid or eqVal.id) then
                excludedUIDs[tostring(eqVal.uid or eqVal._uid or eqVal.id)] = true
            end
        end
    end
    pcall(function()
        local PlayerPetMod = LoadModule(Client, "PlayerPet")
        local activePets = PlayerPetMod and PlayerPetMod.GetByPlayer and PlayerPetMod.GetByPlayer(LocalPlayer)
        if type(activePets) == "table" then
            for euidKey, petObj in pairs(activePets) do
                excludedUIDs[tostring(euidKey)] = true
                if type(petObj) == "table" and petObj.euid then
                    excludedUIDs[tostring(petObj.euid)] = true
                end
            end
        end
    end)

    local desiredCap = math.clamp(tonumber(maxDesiredCrafts) or 10, 1, 25)
    local dirPets = Directory and Directory.Pets

    if saveData and saveData.Inventory and type(saveData.Inventory.Pet) == "table" then
        for uid, petData in pairs(saveData.Inventory.Pet) do
            local uidStr = tostring(uid)
            if type(petData) == "table"
                and not petData.eq and not petData.e and not petData.l and not petData.sh
                and not excludedUIDs[uidStr]
                and not isBlacklisted(uidStr)
                and not currentlyCraftingPetUIDs[uidStr] then

                local petId = tostring(petData.id or petData._id or "")
                local petDef = dirPets and dirPets[petId]
                local isSpecial = petDef and (petDef.huge or petDef.titanic or petDef.exclusiveLevel or petDef.cannotGold)
                local isAllowedEgg = not (isBestEggOnly and bestEggPetSet and not bestEggPetSet[petId])

                if petId ~= "" and not isSpecial and isAllowedEgg then
                    local pt = petData.pt or 0
                    local count = petData._am or 1
                    if machineType == "Gold" and pt == 0 and count >= costPerPet then
                        local maxAvailableCrafts = math.floor(count / costPerPet)
                        local expectedCrafts = math.min(maxAvailableCrafts, desiredCap)
                        local petsToUse = expectedCrafts * costPerPet
                        return uidStr, petsToUse, expectedCrafts, costPerPet
                    elseif machineType == "Rainbow" and pt == 1 and count >= costPerPet then
                        local maxAvailableCrafts = math.floor(count / costPerPet)
                        local expectedCrafts = math.min(maxAvailableCrafts, desiredCap)
                        local petsToUse = expectedCrafts * costPerPet
                        return uidStr, petsToUse, expectedCrafts, costPerPet
                    end
                end
            end
        end
    end

    local successContainer, container = pcall(function() return InventoryCmds.Container() end)
    if successContainer and container then
        local petItems = GetContainerItemsByCategory(container, "Pet")
        if petItems then
            for uid, item in pairs(petItems) do
                local uidStr = tostring(uid)
                if item and not excludedUIDs[uidStr] and not isBlacklisted(uidStr) and not currentlyCraftingPetUIDs[uidStr] then
                    local rawData = item._data or item
                    local petId = tostring((type(item.GetId) == "function" and item:GetId()) or rawData.id or rawData._id or "")
                    local petDef = dirPets and dirPets[petId]
                    local isSpecial = petDef and (petDef.huge or petDef.titanic or petDef.exclusiveLevel or petDef.cannotGold)
                    local isAllowedEgg = not (isBestEggOnly and bestEggPetSet and not bestEggPetSet[petId])
                    local isLocked = rawData.l or (type(item.IsLocked) == "function" and item:IsLocked()) or false
                    local isEquipped = rawData.eq or rawData.e or (type(item.IsEquipped) == "function" and item:IsEquipped()) or false
                    local isShiny = rawData.sh or (type(item.IsShiny) == "function" and item:IsShiny()) or false

                    if petId ~= "" and not isSpecial and isAllowedEgg and not isLocked and not isEquipped and not isShiny then
                        local pt = rawData.pt or 0
                        local count = tonumber((type(item.GetAmount) == "function" and item:GetAmount()) or rawData._am) or 1
                        if machineType == "Gold" and pt == 0 and count >= costPerPet then
                            local maxAvailableCrafts = math.floor(count / costPerPet)
                            local expectedCrafts = math.min(maxAvailableCrafts, desiredCap)
                            local petsToUse = expectedCrafts * costPerPet
                            return uidStr, petsToUse, expectedCrafts, costPerPet
                        elseif machineType == "Rainbow" and pt == 1 and count >= costPerPet then
                            local maxAvailableCrafts = math.floor(count / costPerPet)
                            local expectedCrafts = math.min(maxAvailableCrafts, desiredCap)
                            local petsToUse = expectedCrafts * costPerPet
                            return uidStr, petsToUse, expectedCrafts, costPerPet
                        end
                    end
                end
            end
        end
    end

    return nil, 0, 0, costPerPet
end

local function FindLowestTierCraftableItem(category, targetTier)
    local dirCategory = (category == "Enchant" and Directory and Directory.Enchants)
        or (category == "Potion" and Directory and Directory.Potions)

    local numTargetTier = tonumber(targetTier)
    local exactSourceTier = (numTargetTier and numTargetTier > 1) and (numTargetTier - 1) or nil

    local exactUID, exactTier, exactCraftable, exactName = nil, 999, 0, ""
    local chainUID, chainTier, chainCraftable, chainName = nil, 999, 0, ""

    local function EvaluateCandidate(uidStr, id, tier, amount)
        if not id or id == "" or isBlacklisted(uidStr) then return end
        local itemDef = dirCategory and dirCategory[id]
        local maxTier = (itemDef and itemDef.MaxTier) or 99
        if tier >= maxTier then return end

        local reqPerTier = 5
        if category == "Enchant" and Balancing and Balancing.CalcEnchantsPerTierRequired then
            reqPerTier = Balancing.CalcEnchantsPerTierRequired(tier) or 5
        elseif category == "Potion" and Balancing and Balancing.CalcPotionsPerTierRequired then
            reqPerTier = Balancing.CalcPotionsPerTierRequired(tier) or 5
        end

        local craftCount = math.floor(amount / reqPerTier)
        if craftCount < 1 then return end

        if exactSourceTier then
            if tier == exactSourceTier then
                if craftCount > exactCraftable then
                    exactTier = tier
                    exactUID = uidStr
                    exactCraftable = craftCount
                    exactName = id
                end
            elseif tier < exactSourceTier and tier < chainTier then
                chainTier = tier
                chainUID = uidStr
                chainCraftable = craftCount
                chainName = id
            end
        else
            if tier < exactTier then
                exactTier = tier
                exactUID = uidStr
                exactCraftable = craftCount
                exactName = id
            end
        end
    end

    local saveData = Save.Get()
    if saveData and saveData.Inventory and type(saveData.Inventory[category]) == "table" then
        for uid, itemData in pairs(saveData.Inventory[category]) do
            if type(itemData) == "table" then
                local id = tostring(itemData.id or itemData._id or "")
                local tier = tonumber(itemData.tn or itemData.tier) or 1
                local amount = tonumber(itemData._am or itemData.amount) or 1
                EvaluateCandidate(tostring(uid), id, tier, amount)
            end
        end
    end

    if not exactUID and not chainUID then
        pcall(function()
            local successContainer, container = pcall(function() return InventoryCmds.Container() end)
            if successContainer and container then
                local allItems = GetContainerItemsByCategory(container, category)
                if allItems then
                    for uid, item in pairs(allItems) do
                        if item then
                            local rawData = item._data or item
                            local id = tostring((type(item.GetId) == "function" and item:GetId()) or rawData.id or rawData._id or "")
                            local tier = tonumber((type(item.GetTier) == "function" and item:GetTier()) or rawData.tn or rawData.tier) or 1
                            local amount = tonumber((type(item.GetAmount) == "function" and item:GetAmount()) or rawData._am or rawData.amount) or 1
                            EvaluateCandidate(tostring(uid), id, tier, amount)
                        end
                    end
                end
            end
        end)
    end

    if exactUID then
        return exactUID, exactTier, exactCraftable, exactName
    end
    return chainUID, chainTier, chainCraftable, chainName
end

local machineBlacklistUntil = {}
local MACHINE_MIN_ZONE_REQ = {
    GoldMachine = 6,
    UpgradePotionsMachine = 13,
    UpgradeEnchantsMachine = 16,
    RainbowMachine = 20,
    UpgradeFruitsMachine = 32,
}

local function IsMachineUnlockedByZone(machineName)
    local reqZone = MACHINE_MIN_ZONE_REQ[machineName]
    if not reqZone then return true end
    local unlocked = true
    pcall(function()
        local sd = Save.Get()
        if sd and (sd.Rebirths or 0) >= 1 then
            unlocked = true
            return
        end
        local _, maxZoneData = ZoneCmds.GetMaxOwnedZone()
        local maxZoneNum = (maxZoneData and maxZoneData.ZoneNumber) or 1
        unlocked = (maxZoneNum >= reqZone)
    end)
    return unlocked
end

local function SafeMachineInvoke(machineName, remoteName, itemUID, craftAmount)
    local now = os.clock()
    if machineBlacklistUntil[machineName] and now < machineBlacklistUntil[machineName] then
        return false, "Machine temporarily blacklisted (cooldown active)"
    end
    if not IsMachineUnlockedByZone(machineName) then
        machineBlacklistUntil[machineName] = now + 20
        return false, "Machine zone not unlocked yet"
    end

    local ok, res, errMsg = pcall(function() return Network.Invoke(remoteName, itemUID, craftAmount) end)
    if ok and res then return true, res end

    local errStr = tostring(errMsg or res or "")
    if string.find(errStr, "don't own", 1, true) or string.find(errStr, "not own", 1, true) or string.find(errStr, "cannot use", 1, true) then
        machineBlacklistUntil[machineName] = now + 120
    else
        machineBlacklistUntil[machineName] = now + 25
    end

    return false, (errMsg or "Machine invoke rejected")
end

local function OpenGiftsOrBundlesForQuest(category, desiredCount)
    local saveData = Save.Get()
    if not saveData or not saveData.Inventory or not saveData.Inventory.Misc then return false end

    local bundlePriority = {}
    if category == "Enchant" then
        bundlePriority = { "Enchant Bundle", "Large Enchant Bundle", "Gift Bag", "Large Gift Bag", "Mini Chest", "Diamond Gift Bag" }
    elseif category == "Potion" then
        bundlePriority = { "Potion Bundle", "Large Potion Bundle", "Gift Bag", "Large Gift Bag", "Mini Chest", "Diamond Gift Bag" }
    else
        bundlePriority = { "Gift Bag", "Large Gift Bag", "Mini Chest", "Diamond Gift Bag" }
    end

    local openedAny = false
    for _, bagName in ipairs(bundlePriority) do
        local uid = GetInventoryItemUID("Misc", bagName)
        if uid then
            local bagData = saveData.Inventory.Misc[uid]
            local availableAmt = (type(bagData) == "table" and tonumber(bagData._am or bagData.amount)) or 1
            local openAmt = math.clamp(tonumber(desiredCount) or 2, 1, math.min(availableAmt, 5))
            local success, res = pcall(function()
                return Network.Invoke("GiftBag_Open", bagName, openAmt) or Network.Invoke("GiftBag_Open", bagName, 1) or Network.Invoke("GiftBag_Open", bagName)
            end)
            if success and res == true then
                print(string.format("[MapAuto:Rank] Opened %dx '%s' (%s quest)", openAmt, bagName, category))
                if _G.SetMapAutoStatus then
                    _G.SetMapAutoStatus(string.format("[Gifts] Opened '%s' for quest...", bagName), Color3.fromRGB(255, 200, 50))
                end
                openedAny = true
                break
            end
        end
    end

    if not openedAny then
        local now = os.clock()
        if now - (lastItemSpawnTime["DROP_SPAWNER_FALLBACK"] or 0) > 15 then
            local pinataUID = GetInventoryItemUID("Misc", "Mini Pinata")
            local lbUID = GetInventoryItemUID("Misc", "Mini Lucky Block")
            local cometUID = GetInventoryItemUID("Misc", "Comet")
            local jarUID = GetInventoryItemUID("Misc", "Basic Coin Jar") or GetInventoryItemUID("Misc", "Giant Coin Jar")

            if pinataUID and TrySpawnEventItem("PINATA", "MiniPinata_Consume", pinataUID, "Mini Pinata") then
                lastItemSpawnTime["DROP_SPAWNER_FALLBACK"] = now
                openedAny = true
            elseif lbUID and TrySpawnEventItem("LUCKYBLOCK", "MiniLuckyBlock_Consume", lbUID, "Mini Lucky Block") then
                lastItemSpawnTime["DROP_SPAWNER_FALLBACK"] = now
                openedAny = true
            elseif cometUID and TrySpawnEventItem("COMET", "Comet_Spawn", cometUID, "Comet") then
                lastItemSpawnTime["DROP_SPAWNER_FALLBACK"] = now
                openedAny = true
            elseif jarUID and TrySpawnEventItem("COIN_JAR", "CoinJar_Spawn", jarUID, "Coin Jar") then
                lastItemSpawnTime["DROP_SPAWNER_FALLBACK"] = now
                openedAny = true
            end
        end
    end

    return openedAny
end

function SmartRankManager.Step()
    local saveData = Save.Get()
    if not saveData then return end

    if getgenv().MapAutoConfig.AutoRankClaim then
        local currentRankNum = saveData.Rank or 1
        local rankId = RanksUtil.RankIDFromNumber(currentRankNum)
        if rankId then
            local rankData = Directory.Ranks[rankId]
            if rankData and rankData.Rewards then
                local rankStars = saveData.RankStars or 0
                local redeemedRewards = saveData.RedeemedRankRewards or {}
                local accumStars = 0

                for index, reward in ipairs(rankData.Rewards) do
                    accumStars = accumStars + (reward.StarsRequired or 0)
                    local rewardKey = tostring(index)

                    if rankStars >= accumStars and not redeemedRewards[rewardKey] then
                        print(string.format("[MapAuto:Rank] Claimed reward #%d (Rank %d)", index, currentRankNum))
                        pcall(function()
                            Network.Fire("Ranks_ClaimReward", index)
                        end)
                        task.wait(0.3)
                    end
                end
            end
        end
    end

    if not getgenv().MapAutoConfig.SmartRankItems then return end

    local activeGoals = saveData.Goals or saveData.ActiveGoals or {}

    local seenGoalKeys = {}
    local uniqueGoals = {}
    for _, goal in pairs(activeGoals) do
        local gType = goal.Type or goal.type
        local gAmt = tonumber(goal.Amount) or 1
        local gProg = tonumber(goal.Progress) or 0
        if gType and gProg < gAmt then
            local tierPart = tostring(goal.Tier or goal.PotionTier or goal.EnchantTier or 0)
            local dedupKey = tostring(gType) .. ":" .. tierPart
            if not seenGoalKeys[dedupKey] then
                seenGoalKeys[dedupKey] = true
                table.insert(uniqueGoals, goal)
            end
        end
    end

    for _, goal in ipairs(uniqueGoals) do
        local gType = goal.Type or goal.type
        if gType then
            local now = os.clock()
            local remainingGoal = math.max(1, (tonumber(goal.Amount) or 1) - (tonumber(goal.Progress) or 0))

            if (gType == 37 or gType == 31 or gType == 68) then
                local jarUID = GetInventoryItemUID("Misc", "Basic Coin Jar") or GetInventoryItemUID("Misc", "Giant Coin Jar")
                TrySpawnEventItem("COIN_JAR", "CoinJar_Spawn", jarUID, "Coin Jar")
            end

            if (gType == 38 or gType == 32 or gType == 69) then
                local cometUID = GetInventoryItemUID("Misc", "Comet")
                TrySpawnEventItem("COMET", "Comet_Spawn", cometUID, "Comet")
            end

            if (gType == 66 or gType == 43 or gType == 70) then
                local pinataUID = GetInventoryItemUID("Misc", "Mini Pinata")
                TrySpawnEventItem("PINATA", "MiniPinata_Consume", pinataUID, "Mini Pinata")
            end

            if (gType == 67 or gType == 44 or gType == 71) then
                local lbUID = GetInventoryItemUID("Misc", "Mini Lucky Block")
                TrySpawnEventItem("LUCKYBLOCK", "MiniLuckyBlock_Consume", lbUID, "Mini Lucky Block")
            end

            if (gType == 10 or gType == 11) and (now - (lastItemSpawnTime["VENDING_BUY"] or 0) > 5) then
                lastItemSpawnTime["VENDING_BUY"] = now
                local vmId = (gType == 10) and "PotionVendingMachine1" or "EnchantVendingMachine1"
                local reqZone = (gType == 10) and 6 or 9
                local _, maxZoneData = ZoneCmds.GetMaxOwnedZone()
                local maxZoneNum = (maxZoneData and maxZoneData.ZoneNumber) or 1
                if (saveData.Rebirths or 0) >= 1 or maxZoneNum >= reqZone then
                    pcall(function()
                        Network.Invoke("VendingMachines_Purchase", vmId, math.clamp(remainingGoal, 1, 3))
                    end)
                end
            end

            if (gType == 33) and (now - (lastItemSpawnTime["USE_FLAG"] or 0) > 10) then
                local isInDottedBox = false
                pcall(function()
                    local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
                    if successMap and MapCmds and MapCmds.IsInDottedBox then
                        isInDottedBox = MapCmds.IsInDottedBox()
                    end
                end)

                if isInDottedBox then
                    local isAtMaxContent = false
                    pcall(function()
                        local nextZoneName, nextZoneData = ZoneCmds.GetNextZone()
                        isAtMaxContent = (nextZoneName == nil and nextZoneData == nil)
                    end)

                    local flagPriority
                    if isAtMaxContent then
                        flagPriority = { "Fortune Flag", "Diamonds Flag", "Coins Flag", "Strength Flag", "Magnet Flag", "Hasty Flag" }
                    else
                        flagPriority = { "Coins Flag", "Strength Flag", "Magnet Flag", "Hasty Flag", "Fortune Flag", "Diamonds Flag" }
                    end

                    local placedFlag = false
                    for _, flagName in ipairs(flagPriority) do
                        if placedFlag then break end
                        local flagUID = GetInventoryItemUID("Misc", flagName)
                        if flagUID then
                            local res = false
                            pcall(function()
                                res = Network.Invoke("FlexibleFlags_Consume", flagName, flagUID, 1)
                            end)
                            if res and res ~= false then
                                lastItemSpawnTime["USE_FLAG"] = now
                                print(string.format("[MapAuto:Rank] Placed '%s' (USE_FLAG quest)", flagName))
                                placedFlag = true
                            end
                        end
                    end
                end
            end

            if (gType == 34) and (now - (lastItemSpawnTime["USE_POTION"] or 0) > 2) then
                local reqTier = tonumber(goal.PotionTier or goal.Tier or goal.potionTier) or 1
                local needed = remainingGoal

                local consumedAny = false
                pcall(function()
                    local sd = Save.Get()
                    local successMas, MasteryCmds = pcall(function() return LoadModule(Client, "MasteryCmds") end)
                    local function CanDrinkTier(tier)
                        if successMas and MasteryCmds and MasteryCmds.CanUsePotion then
                            local ok, can = pcall(MasteryCmds.CanUsePotion, tier)
                            if ok then return can == true end
                        end
                        return tier <= 7
                    end

                    if sd and sd.Inventory and sd.Inventory.Potion then
                        for uid, potData in pairs(sd.Inventory.Potion) do
                            if type(potData) == "table" then
                                local tier = tonumber(potData.tn or potData.tier or potData.Tier) or 1
                                local amount = tonumber(potData._am or potData.amount) or 1
                                if tier == reqTier and amount >= 1 and CanDrinkTier(tier) then
                                    local toUse = math.clamp(amount, 1, needed)
                                    lastItemSpawnTime["USE_POTION"] = now
                                    print(string.format("[MapAuto:Rank] Used %dx '%s' Tier %d (USE_POTION quest)", toUse, tostring(potData.id or "Potion"), tier))
                                    Network.Fire("Potions: Consume", tostring(uid), toUse)
                                    needed = needed - toUse
                                    consumedAny = true
                                    if needed <= 0 then break end
                                end
                            end
                        end

                        if needed > 0 then
                            for uid, potData in pairs(sd.Inventory.Potion) do
                                if type(potData) == "table" then
                                    local tier = tonumber(potData.tn or potData.tier or potData.Tier) or 1
                                    local amount = tonumber(potData._am or potData.amount) or 1
                                    if tier >= reqTier and amount >= 1 and CanDrinkTier(tier) then
                                        local toUse = math.clamp(amount, 1, needed)
                                        lastItemSpawnTime["USE_POTION"] = now
                                        print(string.format("[MapAuto:Rank] Used %dx '%s' Tier %d (USE_POTION quest)", toUse, tostring(potData.id or "Potion"), tier))
                                        Network.Fire("Potions: Consume", tostring(uid), toUse)
                                        needed = needed - toUse
                                        consumedAny = true
                                        if needed <= 0 then break end
                                    end
                                end
                            end
                        end
                    end
                end)

                if not consumedAny and (now - (lastItemSpawnTime["POTION_FALLBACK"] or 0) > 4) then
                    lastItemSpawnTime["POTION_FALLBACK"] = now
                    OpenGiftsOrBundlesForQuest("Potion", needed)
                end
            end

            if (gType == 15 or gType == 13) and (now - (lastItemSpawnTime["ENCHANT_UPGRADE"] or 0) > 2) then
                local targetTier = (gType == 13 and (goal.EnchantTier or goal.Tier)) or nil
                local craftSuccess = false

                if IsMachineUnlockedByZone("UpgradeEnchantsMachine") then
                    local bestUID, _, maxCraftable, itemName = FindLowestTierCraftableItem("Enchant", targetTier)
                    if bestUID and maxCraftable > 0 then
                        lastItemSpawnTime["ENCHANT_UPGRADE"] = now
                        local targetAmount = math.clamp(remainingGoal, 1, math.min(maxCraftable, 10))
                        local res = SafeMachineInvoke("UpgradeEnchantsMachine", "UpgradeEnchantsMachine_Activate", bestUID, targetAmount)
                        if res then
                            print(string.format("[MapAuto:Rank] Upgraded %dx '%s' Enchant", targetAmount, tostring(itemName)))
                            machineUIDFailTracker[bestUID] = nil
                            craftSuccess = true
                        end
                    end
                end

                if not craftSuccess and (now - (lastItemSpawnTime["ENCHANT_FALLBACK"] or 0) > 4) then
                    lastItemSpawnTime["ENCHANT_FALLBACK"] = now
                    OpenGiftsOrBundlesForQuest("Enchant", remainingGoal)
                end
            end

            if (gType == 14 or gType == 12) and (now - (lastItemSpawnTime["POTION_UPGRADE"] or 0) > 2) then
                local targetTier = (gType == 12 and (goal.PotionTier or goal.Tier)) or nil
                local craftSuccess = false

                if IsMachineUnlockedByZone("UpgradePotionsMachine") then
                    local bestUID, _, maxCraftable, itemName = FindLowestTierCraftableItem("Potion", targetTier)
                    if bestUID and maxCraftable > 0 then
                        lastItemSpawnTime["POTION_UPGRADE"] = now
                        local targetAmount = math.clamp(remainingGoal, 1, math.min(maxCraftable, 10))
                        local res = SafeMachineInvoke("UpgradePotionsMachine", "UpgradePotionsMachine_Activate", bestUID, targetAmount)
                        if res then
                            print(string.format("[MapAuto:Rank] Upgraded %dx '%s' Potion", targetAmount, tostring(itemName)))
                            machineUIDFailTracker[bestUID] = nil
                            craftSuccess = true
                        end
                    end
                end

                if not craftSuccess and (now - (lastItemSpawnTime["POTION_FALLBACK"] or 0) > 4) then
                    lastItemSpawnTime["POTION_FALLBACK"] = now
                    OpenGiftsOrBundlesForQuest("Potion", remainingGoal)
                end
            end

            if gType == 35 and (now - (lastItemSpawnTime["USE_FRUIT"] or 0) > 2) then
                local needed = remainingGoal

                local specificFruit = goal.FruitID or goal.FruitId or goal.FruitName or goal.Fruit or goal.TargetFruit
                local fruitPriority = { "Apple", "Banana", "Orange", "Pineapple", "Watermelon", "Rainbow" }
                if specificFruit then
                    fruitPriority = { specificFruit }
                end

                local consumedAny = false
                local successFruit, FruitCmds = pcall(function() return LoadModule(Client, "FruitCmds") end)
                local sd = Save.Get()

                if sd and sd.Inventory and sd.Inventory.Fruit then
                    for _, fruitName in ipairs(fruitPriority) do
                        for uid, fruitData in pairs(sd.Inventory.Fruit) do
                            if type(fruitData) == "table" and needed > 0 then
                                local fId = fruitData.id or fruitData._id or tostring(uid)
                                local amount = fruitData._am or fruitData.amount or 1
                                local match = (string.lower(fId) == string.lower(fruitName))
                                    or string.find(string.lower(fId), string.lower(fruitName), 1, true)
                                    or string.find(string.lower(tostring(uid)), string.lower(fruitName), 1, true)

                                if match and amount >= 1 then
                                    local uidStr = tostring(uid)
                                    local maxCanEat = 20
                                    if successFruit and FruitCmds and FruitCmds.GetMaxConsume then
                                        pcall(function() maxCanEat = FruitCmds.GetMaxConsume(uidStr) end)
                                    end

                                    if maxCanEat > 0 then
                                        local toUse = math.clamp(math.min(amount, needed), 1, maxCanEat)
                                        lastItemSpawnTime["USE_FRUIT"] = now
                                        print(string.format("[MapAuto:Rank] Used %dx '%s' (USE_FRUIT quest)", toUse, fId))
                                        pcall(function() Network.Fire("Fruits: Consume", uidStr, toUse) end)
                                        needed = needed - toUse
                                        consumedAny = true
                                    end
                                end
                            end
                        end
                        if needed <= 0 then break end
                    end
                end

                if not consumedAny or needed > 0 then
                    local fruitBagUID = GetInventoryItemUID("Misc", "Fruit Bundle")
                    if fruitBagUID and (now - (lastItemSpawnTime["FRUIT_BAG_OPEN"] or 0) > 3) then
                        lastItemSpawnTime["FRUIT_BAG_OPEN"] = now
                        local ok, res = pcall(function() return Network.Invoke("GiftBag_Open", "Fruit Bundle", 1) or Network.Invoke("GiftBag_Open", "Fruit Bundle") end)
                        if ok and res == true then
                            print("[MapAuto:Rank] Opened Fruit Bundle (USE_FRUIT quest)")
                        end
                    end
                end
            end

            if gType == 65 and (now - (lastItemSpawnTime["COLLECT_FRUIT"] or 0) > 3) then
                lastItemSpawnTime["COLLECT_FRUIT"] = now
                local fruitBagUID = GetInventoryItemUID("Misc", "Fruit Bundle")
                if fruitBagUID then
                    local ok, res = pcall(function() return Network.Invoke("GiftBag_Open", "Fruit Bundle", 1) or Network.Invoke("GiftBag_Open", "Fruit Bundle") end)
                    if ok and res == true then
                        print("[MapAuto:Rank] Opened Fruit Bundle (COLLECT_FRUIT quest)")
                    end
                end
            end

            if gType == 57 and (now - (lastItemSpawnTime["UPGRADE_FRUIT"] or 0) > 3) and IsMachineUnlockedByZone("UpgradeFruitsMachine") then
                local sd = Save.Get()
                if sd and sd.Inventory and sd.Inventory.Fruit then
                    local fruitSelection = {}
                    local totalSelected = 0
                    local fruitsPerRainbow = 20
                    pcall(function()
                        local MasteryCmds = LoadModule(Client, "MasteryCmds")
                        if Balancing and Balancing.Constants and Balancing.Constants.FruitsPerRainbowFruit then
                            fruitsPerRainbow = Balancing.Constants.FruitsPerRainbowFruit
                            if MasteryCmds and MasteryCmds.HasPerk and MasteryCmds.HasPerk("Fruit", "LessFruitRequired") then
                                fruitsPerRainbow = math.max(1, fruitsPerRainbow - (MasteryCmds.GetPerkPower("Fruit", "LessFruitRequired") or 0))
                            end
                        end
                    end)

                    for uid, fruitData in pairs(sd.Inventory.Fruit) do
                        if type(fruitData) == "table" then
                            local fId = fruitData.id or fruitData._id or tostring(uid)
                            if fId ~= "Rainbow" and not fruitData.sh then
                                local amount = fruitData._am or fruitData.amount or 1
                                if amount > 0 then
                                    local take = math.min(amount, fruitsPerRainbow - totalSelected)
                                    fruitSelection[tostring(uid)] = take
                                    totalSelected = totalSelected + take
                                    if totalSelected >= fruitsPerRainbow then break end
                                end
                            end
                        end
                    end

                    if totalSelected >= fruitsPerRainbow then
                        lastItemSpawnTime["UPGRADE_FRUIT"] = now
                        print(string.format("[MapAuto:Rank] Upgraded %dx fruits to Rainbow Fruit", totalSelected))
                        SafeMachineInvoke("UpgradeFruitsMachine", "UpgradeFruitsMachine_Activate", fruitSelection)
                    end
                end
            end

            if (gType == 4 or gType == 40) and IsMachineUnlockedByZone("GoldMachine") then
                local isGoldBlacklisted = machineBlacklistUntil["GoldMachine"] and now < machineBlacklistUntil["GoldMachine"]
                if not isGoldBlacklisted then
                    local isBestEggOnly = (gType == 40)
                    local petUID, petsToUse, expectedGold = FindPetUIDForMachine("Gold", isBestEggOnly, remainingGoal)
                    if petUID and petsToUse > 0 then
                        if now - (lastItemSpawnTime["GOLD_PET"] or 0) > 1.5 then
                            lastItemSpawnTime["GOLD_PET"] = now
                            currentlyCraftingPetUIDs[petUID] = true
                            if _G.SetMapAutoStatus then _G.SetMapAutoStatus(string.format("[Craft] Crafting x%d Golden Pets at Gold Machine...", expectedGold), Color3.fromRGB(255, 215, 0)) end
                            task.spawn(function()
                                local res, errMsg = SafeMachineInvoke("GoldMachine", "GoldMachine_Activate", petUID, expectedGold)
                                currentlyCraftingPetUIDs[petUID] = nil
                                if res then
                                    print(string.format("[MapAuto:Rank] Crafted %dx Golden Pet (used %d pets)", expectedGold, petsToUse))
                                    machineUIDFailTracker[petUID] = nil
                                else
                                    local entry = machineUIDFailTracker[petUID] or { failCount = 0 }
                                    entry.failCount = entry.failCount + 1
                                    if entry.failCount >= 3 then
                                        entry.blacklistedAt = os.clock()
                                    else
                                        warn(string.format("[MapAuto:Rank] GoldMachine failed (%d/3): %s", entry.failCount, tostring(errMsg)))
                                    end
                                    machineUIDFailTracker[petUID] = entry
                                end
                            end)
                        end
                    end
                end
            end

            if (gType == 5 or gType == 41) then
                local isRainbowBlacklisted = machineBlacklistUntil["RainbowMachine"] and now < machineBlacklistUntil["RainbowMachine"]
                local isGoldBlacklisted = machineBlacklistUntil["GoldMachine"] and now < machineBlacklistUntil["GoldMachine"]
                local isBestEggOnly = (gType == 41)
                local craftedRainbow = false

                if not isRainbowBlacklisted and IsMachineUnlockedByZone("RainbowMachine") then
                    local petUID, petsToUse, expectedRainbow = FindPetUIDForMachine("Rainbow", isBestEggOnly, remainingGoal)
                    if petUID and petsToUse > 0 then
                        craftedRainbow = true
                        if now - (lastItemSpawnTime["RAINBOW_PET"] or 0) > 1.5 then
                            lastItemSpawnTime["RAINBOW_PET"] = now
                            currentlyCraftingPetUIDs[petUID] = true
                            if _G.SetMapAutoStatus then _G.SetMapAutoStatus(string.format("[Craft] Crafting x%d Rainbow Pets at Rainbow Machine...", expectedRainbow), Color3.fromRGB(255, 100, 200)) end
                            task.spawn(function()
                                local res, errMsg = SafeMachineInvoke("RainbowMachine", "RainbowMachine_Activate", petUID, expectedRainbow)
                                currentlyCraftingPetUIDs[petUID] = nil
                                if res then
                                    print(string.format("[MapAuto:Rank] Crafted %dx Rainbow Pet (used %d pets)", expectedRainbow, petsToUse))
                                    machineUIDFailTracker[petUID] = nil
                                else
                                    warn(string.format("[MapAuto:Rank] RainbowMachine failed: %s", tostring(errMsg)))
                                end
                            end)
                        end
                    end
                end

                if not craftedRainbow and not isGoldBlacklisted and IsMachineUnlockedByZone("GoldMachine") then
                    local goldNeededForRainbow = math.clamp(remainingGoal * 10, 1, 20)
                    local normUID, normPetsToUse, expectedGold = FindPetUIDForMachine("Gold", isBestEggOnly, goldNeededForRainbow)
                    if normUID and normPetsToUse > 0 then
                        if now - (lastItemSpawnTime["RAINBOW_GOLD_PREP"] or 0) > 5 then
                            lastItemSpawnTime["RAINBOW_GOLD_PREP"] = now
                            currentlyCraftingPetUIDs[normUID] = true
                            task.spawn(function()
                                local res, errMsg = SafeMachineInvoke("GoldMachine", "GoldMachine_Activate", normUID, expectedGold)
                                currentlyCraftingPetUIDs[normUID] = nil
                                if res then
                                    print(string.format("[MapAuto:Rank] Prepared %dx Golden Pet for Rainbow craft", expectedGold))
                                    machineUIDFailTracker[normUID] = nil
                                else
                                    warn(string.format("[MapAuto:Rank] GoldMachine prep failed: %s", tostring(errMsg)))
                                end
                            end)
                        end
                    end
                end
            end
        end
    end

end

local AutoTNTManager = {}

function AutoTNTManager.Step()
    if not getgenv().MapAutoConfig.AutoTNT then return end
    local now = os.clock()
    local tntDelay = tonumber(getgenv().MapAutoConfig.TNTInterval) or 45
    if now - (lastItemSpawnTime["TNT"] or 0) <= tntDelay then return end

    local tntUID = GetInventoryItemUID("Misc", "TNT")
    local crateUID = GetInventoryItemUID("Misc", "TNT Crate")
    if not tntUID and not crateUID then return end

    local canDeploy = false
    pcall(function()
        local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
        local successInst, InstancingCmds = pcall(function() return LoadModule(Client, "InstancingCmds") end)
        if successMap and MapCmds and MapCmds.GetCurrentZone() and (not MapCmds.IsInDottedBox or MapCmds.IsInDottedBox()) then
            canDeploy = true
        end
        if successInst and InstancingCmds and InstancingCmds.IsInInstance and InstancingCmds.IsInInstance() then
            canDeploy = false
        end
    end)
    if not canDeploy then return end

    lastItemSpawnTime["TNT"] = now
    if _G.SetMapAutoStatus then
        _G.SetMapAutoStatus("[TNT] Deploying TNT explosives in field...", Color3.fromRGB(255, 170, 0))
    end

    if tntUID then
        local ok, res = pcall(function() return Network.Invoke("TNT_Consume") end)
        if ok and res == true then
            print("[MapAuto:TNT] Deployed 'TNT'")
        end
        if crateUID then
            task.wait(0.55)
        end
    end

    if crateUID then
        local ok, res = pcall(function() return Network.Invoke("TNT_Crate_Consume") end)
        if ok and res == true then
            print("[MapAuto:TNT] Deployed 'TNT Crate'")
        end
    end
end

local RankEggManager = {}
local lastEggLogTime = 0

local lastRankEggMaterialScan = 0
local cachedNeedGoldHatch = false
local cachedNeedRainbowHatch = false

function RankEggManager.Step()
    if not getgenv().MapAutoConfig.SmartRankItems then return end

    local saveData = Save.Get()
    if not saveData then return end

    local activeGoals = saveData.Goals or saveData.ActiveGoals or {}
    if not activeGoals then return end

    local needsEggHatch = false
    local isBestEggRequired = false
    local hatchReason = ""

    local now = os.clock()
    local canRescanMaterials = (now - lastRankEggMaterialScan) >= 5.0

    for _, goal in pairs(activeGoals) do
        local gType = goal.Type or goal.type
        local gAmt = tonumber(goal.Amount) or 1
        local gProg = tonumber(goal.Progress) or 0
        if gType and gProg < gAmt then
            if gType == 20 or gType == 42 or gType == 83 then
                needsEggHatch = true
                isBestEggRequired = true
                hatchReason = (gType == 42 and "Legendary Pet Quest") or "Best Egg Quest"
                break
            elseif gType == 40 and IsMachineUnlockedByZone("GoldMachine") then
                local isGoldBlocked = machineBlacklistUntil["GoldMachine"] and now < machineBlacklistUntil["GoldMachine"]
                if not isGoldBlocked then
                    if canRescanMaterials then
                        lastRankEggMaterialScan = now
                        local petUID, petsToUse = FindPetUIDForMachine("Gold", true, 1)
                        cachedNeedGoldHatch = (not petUID or petsToUse <= 0)
                    end
                    if cachedNeedGoldHatch then
                        needsEggHatch = true
                        isBestEggRequired = true
                        hatchReason = "Best Gold Pet Material"
                        break
                    end
                end
            elseif gType == 41 and (IsMachineUnlockedByZone("RainbowMachine") or IsMachineUnlockedByZone("GoldMachine")) then
                local isRainbowBlocked = (machineBlacklistUntil["RainbowMachine"] and now < machineBlacklistUntil["RainbowMachine"])
                    or (machineBlacklistUntil["GoldMachine"] and now < machineBlacklistUntil["GoldMachine"])
                if not isRainbowBlocked then
                    if canRescanMaterials then
                        lastRankEggMaterialScan = now
                        local petUID, petsToUse = FindPetUIDForMachine("Rainbow", true, 1)
                        if not petUID or petsToUse <= 0 then
                            local normUID, normPetsToUse = FindPetUIDForMachine("Gold", true, 1)
                            cachedNeedRainbowHatch = (not normUID or normPetsToUse <= 0)
                        else
                            cachedNeedRainbowHatch = false
                        end
                    end
                    if cachedNeedRainbowHatch then
                        needsEggHatch = true
                        isBestEggRequired = true
                        hatchReason = "Best Rainbow Pet Material"
                        break
                    end
                end
            elseif gType == 3 or gType == 2 then
                needsEggHatch = true
                isBestEggRequired = true
                if not hatchReason or hatchReason == "" then hatchReason = "Generic Egg Quest" end
            end
        end
    end

    if not needsEggHatch then return end

    local now = os.clock()
    if not EggPurchaseReady(now) then return end

    local targetEggID = nil
    if isBestEggRequired then
        local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
        local zoneDef = Directory and Directory.Zones
            and (Directory.Zones[maxZoneName] or (maxZoneData and maxZoneData._id and Directory.Zones[maxZoneData._id]))
        local maxEggNum = (zoneDef and (zoneDef.MaximumAvailableEgg or zoneDef.maximumAvailableEgg)) or (saveData.MaximumAvailableEgg) or 1

        if Directory and Directory.Eggs then
            for eggID, eggData in pairs(Directory.Eggs) do
                if eggData.eggNumber == maxEggNum then
                    targetEggID = eggID
                    break
                end
            end
        end
    end

    if targetEggID then
        local maxHatch = 1
        pcall(function()
            local successEggCmd, EggCmds = pcall(function() return LoadModule(Client, "EggCmds") end)
            if successEggCmd and EggCmds and EggCmds.GetMaxHatch then
                maxHatch = EggCmds.GetMaxHatch()
            else
                maxHatch = saveData.EggHatchCount or 1
            end
        end)

        if now - lastEggLogTime > 10 then
            lastEggLogTime = now
            print(string.format("[MapAuto:RankEgg] Hatching '%s' (x%d) [%s]", tostring(targetEggID), maxHatch, hatchReason))
            if _G.SetMapAutoStatus then
                _G.SetMapAutoStatus(string.format("[Hatch] Hatching '%s' (x%d)...", tostring(targetEggID), maxHatch), Color3.fromRGB(255, 220, 100))
            end
        end

        pcall(function()
            task.spawn(function()
                local ok, res = pcall(Network.Invoke, "Eggs_RequestPurchase", targetEggID, maxHatch)
                EggPurchaseDone(ok and type(res) == "boolean" and res == true, now)
            end)
        end)
    end
end

