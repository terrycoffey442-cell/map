local FreeGiftsManager = {}
local lastFreeGiftAttempt = 0
local timedRewardCooldownUntil = {}

function FreeGiftsManager.Step()
    if not getgenv().MapAutoConfig.AutoFreeGifts then return end
    local now = os.clock()
    if now - lastFreeGiftAttempt < 15 then return end
    lastFreeGiftAttempt = now

    local saveData = Save.Get()
    if not saveData then return end

    task.spawn(function()
        local redeemedSet = {}
        for _, giftIdx in pairs(saveData.FreeGiftsRedeemed or {}) do
            redeemedSet[tonumber(giftIdx) or giftIdx] = true
        end
        local elapsedTime = tonumber(saveData.FreeGiftsTime) or 0
        local freeGiftsDir = Directory and Directory.FreeGifts

        for i = 1, 12 do
            if not redeemedSet[i] then
                local giftDef = freeGiftsDir and freeGiftsDir[i]
                local reqTime = (giftDef and tonumber(giftDef.waitTime)) or 0
                if elapsedTime >= reqTime then
                    pcall(function()
                        local res = Network.Invoke("Redeem Free Gift", i)
                        if res then
                            print(string.format("[MapAuto:Gift] Claimed free gift #%d", i))
                        end
                    end)
                    task.wait(0.15)
                end
            end
        end
    end)

    task.spawn(function()
        local serverNow = workspace:GetServerTimeNow()
        if Directory and Directory.TimedRewards then
            local savedTimed = saveData.TimedRewards or {}
            for machineId, machineDef in pairs(Directory.TimedRewards) do
                local key = tostring(machineId)
                if now >= (timedRewardCooldownUntil[key] or 0) then
                    local nextReadyAt = tonumber(savedTimed[key] or savedTimed[machineId]) or 0
                    local reqZone = type(machineDef) == "table" and (machineDef.ZoneID or machineDef.Zone or machineDef.Location)
                    local zoneOwned = true
                    if reqZone and ZoneCmds and ZoneCmds.Owns then
                        pcall(function() zoneOwned = ZoneCmds.Owns(reqZone) end)
                    end

                    if zoneOwned and serverNow >= nextReadyAt then
                        pcall(function()
                            local res = Network.Invoke("DailyRewards_Redeem", key)
                            if res then
                                print(string.format("[MapAuto:Gift] Claimed daily reward '%s'", key))
                                timedRewardCooldownUntil[key] = os.clock() + 300
                            else
                                timedRewardCooldownUntil[key] = os.clock() + 120
                            end
                        end)
                        task.wait(0.15)
                    else
                        timedRewardCooldownUntil[key] = os.clock() + 60
                    end
                end
            end
        end

        pcall(function()
            local sd = Save.Get()
            if sd and (not sd.ZoneSurgesTimestamp or sd.ZoneSurgesTimestamp <= workspace:GetServerTimeNow()) then
                if now >= (timedRewardCooldownUntil["__ZoneSurge"] or 0) then
                    local success = Network.Invoke("Zone Surges: Activate")
                    if success then
                        print("[MapAuto:Gift] Activated zone surge machine")
                        timedRewardCooldownUntil["__ZoneSurge"] = os.clock() + 300
                    else
                        timedRewardCooldownUntil["__ZoneSurge"] = os.clock() + 120
                    end
                end
            end
        end)
    end)
end

local DaycareManager = {}
local lastDaycareCheckTime = 0

function DaycareManager.Step()
    if getgenv().MapAutoConfig.AutoDaycare == false then return end
    if os.clock() - lastDaycareCheckTime < 15 then return end
    lastDaycareCheckTime = os.clock()

    pcall(function()
        local saveData = Save.Get()
        local myRank = (saveData and saveData.Rank) or 1
        if myRank < 3 then return end

        local successDaycareCmd, DaycareCmds = pcall(function() return LoadModule(Client, "DaycareCmds") end)
        if not successDaycareCmd or not DaycareCmds then return end

        local activeList = nil
        pcall(function() activeList = DaycareCmds.GetActive() end)
        local hasClaimable = false
        if activeList then
            for uid, _ in pairs(activeList) do
                local remTime = (1 / 0)
                pcall(function() remTime = DaycareCmds.ComputeRemainingTime(uid) end)
                if remTime <= 0 then
                    hasClaimable = true
                    break
                end
            end
        end

        if hasClaimable then
            local ok, res = pcall(function() return Network.Invoke("Daycare: Claim") end)
            if ok and res ~= false then
                print("[MapAuto:Daycare] Claimed daycare rewards")
            end
        end

        local maxSlots = 10
        local usedSlots = 0
        pcall(function() maxSlots = DaycareCmds.GetMaxSlots() end)
        pcall(function() usedSlots = DaycareCmds.GetUsedSlots() end)

        local availableSlots = math.max(0, maxSlots - usedSlots)
        if availableSlots <= 0 then return end

        local excludedUIDs = {}
        for _, slot in pairs(saveData.DaycareActive or {}) do
            local petUID = slot.Pet and (slot.Pet._id or slot.Pet._uid or slot.Pet.uid)
            if petUID then excludedUIDs[tostring(petUID)] = true end
        end
        for _, slot in pairs(saveData.ExclusiveDaycareActive or {}) do
            local petUID = slot.Pet and (slot.Pet._id or slot.Pet._uid or slot.Pet.uid)
            if petUID then excludedUIDs[tostring(petUID)] = true end
        end
        for eqKey, eqVal in pairs(saveData.EquippedPets or {}) do
            excludedUIDs[tostring(eqKey)] = true
            if type(eqVal) == "string" or type(eqVal) == "number" then
                excludedUIDs[tostring(eqVal)] = true
            elseif type(eqVal) == "table" and (eqVal.uid or eqVal._uid or eqVal.id) then
                excludedUIDs[tostring(eqVal.uid or eqVal._uid or eqVal.id)] = true
            end
        end
        pcall(function()
            local PlayerPetMod = LoadModule(Client, "PlayerPet")
            local activePets = PlayerPetMod and PlayerPetMod.GetByPlayer and PlayerPetMod.GetByPlayer(LocalPlayer)
            if type(activePets) == "table" then
                for euidKey, petObj in pairs(activePets) do
                    excludedUIDs[tostring(euidKey)] = true
                    if type(petObj) == "table" and petObj.euid then
                        excludedUIDs[tostring(petObj.euid)] = true
                    end
                end
            end
        end)

        local enrollTable = {}
        local countAdded = 0
        local dirPets = Directory and Directory.Pets

        if saveData.Inventory and type(saveData.Inventory.Pet) == "table" then
            for uid, itemData in pairs(saveData.Inventory.Pet) do
                if countAdded >= availableSlots then break end
                local uidStr = tostring(uid)
                if type(itemData) == "table"
                    and not itemData.eq and not itemData.e and not itemData.l and not itemData._lk
                    and not excludedUIDs[uidStr] then
                    local petId = tostring(itemData.id or itemData._id or "")
                    local petDef = dirPets and dirPets[petId]
                    local isSpecial = petDef and (petDef.huge or petDef.titanic or petDef.exclusiveLevel or petDef.ugc)
                    if petId ~= "" and not isSpecial then
                        local petAmount = tonumber(itemData._am) or 1
                        if petAmount > 0 then
                            local amountToSend = math.min(petAmount, availableSlots - countAdded)
                            enrollTable[uidStr] = amountToSend
                            countAdded = countAdded + amountToSend
                        end
                    end
                end
            end
        end

        if countAdded > 0 then
            local ok, res, errMsg = pcall(function() return DaycareCmds.Enroll(enrollTable) end)
            if not ok or res == false then
                pcall(function() ok, res, errMsg = Network.Invoke("Daycare: Enroll", enrollTable) end)
            end

            if ok and res ~= false then
                print(string.format("[MapAuto:Daycare] Enrolled %d pets", countAdded))
            else
                warn(string.format("[MapAuto:Daycare] Enroll failed: %s", tostring(errMsg)))
            end
        end
    end)
end

local AutoFlagManager = {}
local lastFlagCheckTime = 0
local lastPlacedFlagByZone = {}

local function GetAvailableFlag(isAtMaxContent)
    local ownedFlags = {}
    local saveData = Save.Get()
    local miscTable = saveData and saveData.Inventory and saveData.Inventory.Misc
    if type(miscTable) == "table" then
        for _, itemData in pairs(miscTable) do
            if type(itemData) == "table" then
                local id = tostring(itemData.id or itemData._id or "")
                if string.find(id, "Flag", 1, true) then
                    ownedFlags[id] = true
                end
            end
        end
    end

    local priorityList
    if isAtMaxContent then
        priorityList = { "Fortune Flag", "Diamonds Flag", "Coins Flag", "Strength Flag", "Magnet Flag", "Hasty Flag" }
    else
        priorityList = { "Coins Flag", "Strength Flag", "Magnet Flag", "Hasty Flag", "Fortune Flag", "Diamonds Flag" }
    end

    for _, flagName in ipairs(priorityList) do
        if ownedFlags[flagName] then
            return flagName
        end
    end

    return priorityList[1]
end

function AutoFlagManager.Step()
    if getgenv().MapAutoConfig.AutoFlags == false then return end
    local now = os.clock()
    if now - lastFlagCheckTime < 8 then return end
    lastFlagCheckTime = now

    pcall(function()
        local successZone, ZoneCmds = pcall(function() return LoadModule(Client, "ZoneCmds") end)
        local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
        local successFlex, FlexibleFlagCmds = pcall(function() return LoadModule(Client, "FlexibleFlagCmds") end)
        local successFlag, ZoneFlagCmds = pcall(function() return LoadModule(Client, "ZoneFlagCmds") end)
        if not successZone or not ZoneCmds then return end

        local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
        local maxZoneID = (maxZoneData and maxZoneData._id) or maxZoneName

        local currentZoneNoVerif = nil
        pcall(function()
            if successMap and MapCmds and MapCmds.GetCurrentZoneNoVerification then
                currentZoneNoVerif = MapCmds.GetCurrentZoneNoVerification()
            end
        end)

        local currentZoneName = currentZoneNoVerif
            or (successMap and MapCmds and MapCmds.GetCurrentZone())
            or maxZoneID
        if not currentZoneName then currentZoneName = maxZoneID end

        local zoneVariants = {}
        local seenVariant = {}
        local function addZoneVariant(z)
            if z and not seenVariant[z] then
                seenVariant[z] = true
                table.insert(zoneVariants, z)
            end
        end
        addZoneVariant(maxZoneData and maxZoneData._id)
        addZoneVariant(currentZoneName)
        addZoneVariant(maxZoneName)

        for _, z in ipairs(zoneVariants) do
            if lastPlacedFlagByZone[z] and (now - lastPlacedFlagByZone[z]) < 240 then
                return
            end
        end

        local isAtMaxContent = false
        local canAlreadyAffordNextZone = false
        pcall(function()
            local nextZoneName, nextZoneData = ZoneCmds.GetNextZone()
            isAtMaxContent = (nextZoneName == nil and nextZoneData == nil)
            if nextZoneData and getgenv().MapAutoConfig.AutoMap then
                local hasQuests = (not ZoneCmds.HasCompletedNextZoneQuests) or ZoneCmds.HasCompletedNextZoneQuests()
                local price = Balancing and Balancing.CalcGatePrice and Balancing.CalcGatePrice(nextZoneData) or 0
                local currency = nextZoneData.Currency or "Coins"
                if hasQuests and price > 0 and CurrencyCmds and CurrencyCmds.CanAfford and CurrencyCmds.CanAfford(currency, price) then
                    canAlreadyAffordNextZone = true
                end
            end
        end)

        if canAlreadyAffordNextZone then return end

        local targetFlagName = GetAvailableFlag(isAtMaxContent)
        if not targetFlagName then return end

        if string.find(tostring(currentZoneName), "Spawn", 1, true) or string.find(tostring(maxZoneID), "Spawn", 1, true) then
            return
        end

        local physicalFlagActive = false
        pcall(function()
            local char = LocalPlayer.Character
            local root = char and char.PrimaryPart
            if not root then return end
            local things = workspace:FindFirstChild("__THINGS")
            local flagsFolder = things and things:FindFirstChild("Flags")
            if flagsFolder then
                for _, flagModel in ipairs(flagsFolder:GetChildren()) do
                    if flagModel:IsA("Model") then
                        local pivot = flagModel:GetPivot()
                        if (pivot.Position - root.Position).Magnitude <= 120 then
                            physicalFlagActive = true
                            break
                        end
                    end
                end
            end
        end)

        if physicalFlagActive then return end

        local activeFlagInfo = nil
        pcall(function()
            if successFlex and FlexibleFlagCmds and FlexibleFlagCmds.GetActiveFlag then
                for _, z in ipairs(zoneVariants) do
                    local info = FlexibleFlagCmds.GetActiveFlag(1, z, "Main")
                    if info then
                        activeFlagInfo = info
                        break
                    end
                end
            end
            if not activeFlagInfo and successFlag and ZoneFlagCmds and ZoneFlagCmds.GetActiveFlag then
                for _, z in ipairs(zoneVariants) do
                    local info = ZoneFlagCmds.GetActiveFlag(z)
                    if info then
                        activeFlagInfo = info
                        break
                    end
                end
            end
        end)

        local needsPlacement = false
        if not activeFlagInfo then
            needsPlacement = true
        else
            local remTime = 0
            pcall(function()
                if activeFlagInfo.EndTime then
                    remTime = activeFlagInfo.EndTime - workspace:GetServerTimeNow()
                end
            end)
            if remTime <= 30 then
                needsPlacement = true
            else
                return
            end
        end

        local isInDottedBox = false
        pcall(function()
            if successMap and MapCmds and MapCmds.IsInDottedBox then
                isInDottedBox = MapCmds.IsInDottedBox()
            end
        end)
        if not isInDottedBox then return end

        if needsPlacement then
            local targetFlagUID = GetInventoryItemUID("Misc", targetFlagName)
            if not targetFlagUID then return end

            local res = false
            pcall(function()
                if successFlex and FlexibleFlagCmds and FlexibleFlagCmds.Consume then
                    res = FlexibleFlagCmds.Consume(targetFlagName, targetFlagUID, 1)
                end
            end)

            if not res or res == false then
                pcall(function() res = Network.Invoke("FlexibleFlags_Consume", targetFlagName, targetFlagUID, 1) end)
            end

            if res and res ~= false then
                local placedAt = os.clock()
                for _, z in ipairs(zoneVariants) do
                    lastPlacedFlagByZone[z] = placedAt
                end
                print(string.format("[MapAuto:Flag] Placed '%s' at '%s'", targetFlagName, tostring(currentZoneName)))
            else
                lastFlagCheckTime = os.clock() + 15
            end
        end
    end)
end

local SprinklerManager = {}
local lastSprinklerCheck = 0
local lastPlacedSprinklerByZone = {}

function SprinklerManager.Step()
    if getgenv().MapAutoConfig.AutoSprinkler == false then return end
    local now = os.clock()
    if now - lastSprinklerCheck < 10 then return end
    lastSprinklerCheck = now

    pcall(function()
        local successSprinkler, SprinklerCmds = pcall(function() return LoadModule(Client, "SprinklerCmds") end)
        local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
        local successZone, ZoneCmds2 = pcall(function() return LoadModule(Client, "ZoneCmds") end)
        if not successSprinkler or not SprinklerCmds then return end

        local isInDottedBox = false
        pcall(function()
            if successMap and MapCmds and MapCmds.IsInDottedBox then
                isInDottedBox = MapCmds.IsInDottedBox()
            end
        end)
        if not isInDottedBox then return end

        local maxZoneName, maxZoneData = nil, nil
        if successZone and ZoneCmds2 and ZoneCmds2.GetMaxOwnedZone then
            maxZoneName, maxZoneData = ZoneCmds2.GetMaxOwnedZone()
        end
        local mapZone = (successMap and MapCmds and MapCmds.GetCurrentZone and MapCmds.GetCurrentZone()) or nil
        local currentZone = (maxZoneData and maxZoneData._id) or maxZoneName or mapZone
        if not currentZone then return end

        local zoneVariants = {}
        if currentZone then table.insert(zoneVariants, currentZone) end
        if mapZone and mapZone ~= currentZone then table.insert(zoneVariants, mapZone) end
        if maxZoneName and maxZoneName ~= currentZone and maxZoneName ~= mapZone then table.insert(zoneVariants, maxZoneName) end

        for _, z in ipairs(zoneVariants) do
            if lastPlacedSprinklerByZone[z] and (now - lastPlacedSprinklerByZone[z]) < 240 then
                return
            end
        end

        local canAlreadyAffordNextZone = false
        pcall(function()
            if successZone and ZoneCmds2 and ZoneCmds2.GetNextZone and getgenv().MapAutoConfig.AutoMap then
                local _, nextZoneData = ZoneCmds2.GetNextZone()
                if nextZoneData then
                    local hasQuests = (not ZoneCmds2.HasCompletedNextZoneQuests) or ZoneCmds2.HasCompletedNextZoneQuests()
                    local price = Balancing and Balancing.CalcGatePrice and Balancing.CalcGatePrice(nextZoneData) or 0
                    local currency = nextZoneData.Currency or "Coins"
                    if hasQuests and price > 0 and CurrencyCmds and CurrencyCmds.CanAfford and CurrencyCmds.CanAfford(currency, price) then
                        canAlreadyAffordNextZone = true
                    end
                end
            end
        end)
        if canAlreadyAffordNextZone then return end

        local sprinklerUID = nil
        local sprinklerItemId = nil
        pcall(function()
            local sd = Save.Get()
            if sd and sd.Inventory and sd.Inventory.Misc then
                for uid, itemData in pairs(sd.Inventory.Misc) do
                    if type(itemData) == "table" then
                        local id = tostring(itemData.id or itemData._id or "")
                        if id:lower():find("sprinkler") then
                            sprinklerUID = tostring(uid)
                            sprinklerItemId = id
                            break
                        end
                    end
                end
            end
        end)

        if not sprinklerUID or not sprinklerItemId then return end

        local hasActive = false
        pcall(function()
            if SprinklerCmds.PlayerHasActiveSprinkler then
                hasActive = SprinklerCmds.PlayerHasActiveSprinkler(sprinklerItemId)
            end
            if not hasActive and SprinklerCmds.GetActiveSprinkler then
                local serverNow = workspace:GetServerTimeNow()
                for _, z in ipairs(zoneVariants) do
                    local activeSprinkler = SprinklerCmds.GetActiveSprinkler(z)
                    if activeSprinkler and activeSprinkler.EndTime and (activeSprinkler.EndTime - serverNow) > 60 then
                        hasActive = true
                        break
                    end
                end
            end
        end)

        if hasActive then return end

        local ok, res = pcall(function()
            if SprinklerCmds.Consume then
                return SprinklerCmds.Consume(sprinklerItemId, sprinklerUID, 1)
            end
            return Network.Invoke("Sprinklers: Consume", sprinklerItemId, sprinklerUID, 1)
        end)

        if ok and res ~= false then
            local placedAt = os.clock()
            for _, z in ipairs(zoneVariants) do
                lastPlacedSprinklerByZone[z] = placedAt
            end
            print(string.format("[MapAuto:Sprinkler] Placed '%s' at '%s'", sprinklerItemId, tostring(currentZone)))
            lastSprinklerCheck = placedAt + 20
        else
            lastSprinklerCheck = os.clock() + 15
        end
    end)
end

local ShinyRelicManager = {}
local lastRelicCheckTime = 0
local cachedWorldRelics = nil
local attemptedRelicMaxZone = {}

function ShinyRelicManager.Step()
    if getgenv().MapAutoConfig.AutoShinyRelics == false then return end
    if os.clock() - lastRelicCheckTime < 60 then return end
    lastRelicCheckTime = os.clock()

    task.spawn(function()
        pcall(function()
            if not cachedWorldRelics then
                pcall(function() cachedWorldRelics = Network.Invoke("Relics_Request") end)
            end
            if not cachedWorldRelics or type(cachedWorldRelics) ~= "table" then return end

            local saveData = Save.Get()
            local ownedSet = {}
            for _, id in ipairs((saveData and saveData.ShinyRelics) or {}) do
                ownedSet[id] = true
            end

            local _, maxZoneData = ZoneCmds.GetMaxOwnedZone()
            local maxZoneNum = (maxZoneData and maxZoneData.ZoneNumber) or 1

            local uncollectedList = {}
            for _, relicData in pairs(cachedWorldRelics) do
                if type(relicData) == "table" and relicData.Id and not ownedSet[relicData.Id] then
                    local rId = relicData.Id
                    local parentZone = relicData.ParentId
                    local isZoneOwned = true
                    if parentZone and type(parentZone) == "string" and ZoneCmds and ZoneCmds.Owns then
                        pcall(function() isZoneOwned = ZoneCmds.Owns(parentZone) end)
                    end
                    if isZoneOwned and attemptedRelicMaxZone[rId] ~= maxZoneNum then
                        table.insert(uncollectedList, rId)
                    end
                end
            end

            if #uncollectedList > 0 then
                for _, rId in ipairs(uncollectedList) do
                    attemptedRelicMaxZone[rId] = maxZoneNum
                    pcall(function()
                        local success, count = Network.Invoke("Relic_Found", rId)
                        if success then
                            ownedSet[rId] = true
                            print(string.format("[MapAuto:Relic] Claimed shiny relic #%s (total: %s)", tostring(rId), tostring(count)))
                        end
                    end)
                    task.wait(0.3)
                end
            end
        end)
    end)
end

local MaxZoneEggManager = {}
local lastMaxEggLogTime = 0

local lastEggPurchaseTime = 0
local eggPurchaseFailStreak = 0
local EGG_PURCHASE_MIN_INTERVAL = 2.5
local EGG_PURCHASE_MAX_INTERVAL = 40

local function EggPurchaseReady(now)
    local interval = math.min(EGG_PURCHASE_MIN_INTERVAL * (2 ^ math.min(eggPurchaseFailStreak, 4)), EGG_PURCHASE_MAX_INTERVAL)
    return (now - lastEggPurchaseTime) >= interval
end

local function EggPurchaseDone(success, now)
    lastEggPurchaseTime = now
    if success then
        eggPurchaseFailStreak = 0
    else
        eggPurchaseFailStreak = eggPurchaseFailStreak + 1
    end
end

function MaxZoneEggManager.Step()
    if getgenv().MapAutoConfig.AutoHatchAtMaxZone == false then return end

    local now = os.clock()
    if not EggPurchaseReady(now) then return end

    local isAtMaxContent = false
    pcall(function()
        local nextZoneName, nextZoneData = ZoneCmds.GetNextZone()
        isAtMaxContent = (nextZoneName == nil and nextZoneData == nil)
    end)
    if not isAtMaxContent then return end

    local saveData = Save.Get()
    if not saveData then return end

    local maxEggNum = saveData.MaximumAvailableEgg or 1
    local targetEggID = nil
    if Directory and Directory.Eggs then
        for eggID, eggData in pairs(Directory.Eggs) do
            if eggData.eggNumber == maxEggNum then
                targetEggID = eggID
                break
            end
        end
    end

    if targetEggID then
        local maxHatch = 1
        pcall(function()
            local successEggCmd, EggCmds = pcall(function() return LoadModule(Client, "EggCmds") end)
            if successEggCmd and EggCmds and EggCmds.GetMaxHatch then
                maxHatch = EggCmds.GetMaxHatch()
            else
                maxHatch = saveData.EggHatchCount or 1
            end
        end)

        if now - lastMaxEggLogTime > 20 then
            lastMaxEggLogTime = now
            print(string.format("[MapAuto:Hatch] Max zone reached, hatching '%s' (x%d)", tostring(targetEggID), maxHatch))
        end

        pcall(function()
            task.spawn(function()
                local ok, res = pcall(Network.Invoke, "Eggs_RequestPurchase", targetEggID, maxHatch)
                EggPurchaseDone(ok and type(res) == "boolean" and res == true, now)
            end)
        end)
    end
end

local AutoMasteryManager = {}
local lastMasteryCheckTime = 0

function AutoMasteryManager.Step()
    local targetMasteryList = getgenv().MapAutoConfig.auto_mas or getgenv().MapAutoConfig.AutoMasteryList
    if not targetMasteryList or type(targetMasteryList) ~= "table" or #targetMasteryList == 0 then
        return
    end

    local now = os.clock()
    if now - lastMasteryCheckTime < 10 then return end
    lastMasteryCheckTime = now

    pcall(function()
        local successMastery, MasteryCmds = pcall(function() return LoadModule(Client, "MasteryCmds") end)
        if not successMastery or not MasteryCmds then return end

        if MasteryCmds.MasteryUnlocked and not MasteryCmds.MasteryUnlocked() then
            return
        end

        local ultraPotionUID = GetInventoryItemUID("XPPotion", "Ultra Mastery")
            or GetInventoryItemUID("Potion", "Ultra Mastery")
            or GetInventoryItemUID("Misc", "Ultra Mastery")

        if not ultraPotionUID then
            local saveData = Save.Get()
            if saveData and saveData.Inventory then
                for _, catKey in ipairs({ "XPPotion", "Potion", "Misc" }) do
                    local catTable = saveData.Inventory[catKey]
                    if type(catTable) == "table" then
                        for uid, itemData in pairs(catTable) do
                            if type(itemData) == "table" then
                                local id = tostring(itemData.id or itemData._id or "")
                                if string.find(id:lower(), "ultra mastery", 1, true) then
                                    ultraPotionUID = tostring(uid)
                                    break
                                end
                            end
                        end
                    end
                    if ultraPotionUID then break end
                end
            end
        end

        if not ultraPotionUID then return end

        for _, masName in ipairs(targetMasteryList) do
            local currentLvl = 99
            pcall(function()
                currentLvl = MasteryCmds.GetLevel(masName)
            end)

            if currentLvl < 99 then
                local success, res = pcall(function()
                    return Network.Invoke("XPPotions: Consume", "Ultra Mastery", 1, masName)
                end)

                if success and res ~= false then
                    print(string.format("[MapAuto:Mastery] Upgraded '%s' mastery to level 99 (from %d)", tostring(masName), currentLvl))
                    task.wait(1)
                    break
                else
                    warn(string.format("[MapAuto:Mastery] Ultra Mastery Potion failed for '%s': %s", tostring(masName), tostring(res)))
                end
            end
        end
    end)
end

