local function AutoDismissErrorPopups()
    pcall(function()
        local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return end

        local messageGui = playerGui:FindFirstChild("Message")
        if messageGui then
            if not autoDismissConnected then
                autoDismissConnected = true
                AddConnection(messageGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if messageGui.Enabled then
                        messageGui.Enabled = false
                        pcall(function()
                            local TabController = LoadModule(Client, "TabController")
                            if TabController then
                                TabController.CloseTab("Message")
                                TabController.CloseTab()
                            end
                        end)
                    end
                end))
            end

            if messageGui.Enabled then
                messageGui.Enabled = false
                local successTab, TabController = pcall(function() return LoadModule(Client, "TabController") end)
                if successTab and TabController and TabController.IsOpen and TabController.IsOpen("Message") then
                    pcall(function() TabController.CloseTab("Message") end)
                    pcall(function() TabController.CloseTab() end)
                end
            end
        end
    end)
