local machineTeleportLockUntil = 0
local MACHINE_TELEPORT_LOCK_MS = 0.55
local function IsMachineTeleporting()
    return os.clock() < machineTeleportLockUntil
end
local function SetMachineTeleporting(duration)
    local lockDur = duration or MACHINE_TELEPORT_LOCK_MS
    local targetUntil = os.clock() + lockDur
    if targetUntil > machineTeleportLockUntil then
        machineTeleportLockUntil = targetUntil
    end
end

