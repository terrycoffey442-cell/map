local lastFailedEggSlotDiamonds = -1

function SlotsMachineManager.Step()
    if not getgenv().MapAutoConfig.AutoEquipSlots then return end
    local now = os.clock()
    if now - lastSlotAttempt < 3 then return end
    lastSlotAttempt = now

    local saveData = Save.Get()
    if not saveData then return end

    local successRank, RankCmds = pcall(function() return LoadModule(Client, "RankCmds") end)

    local currentDiamonds = 0
    pcall(function()
        if CurrencyCmds and CurrencyCmds.Get then
            currentDiamonds = CurrencyCmds.Get("Diamonds") or 0
        elseif saveData.Diamonds then
            currentDiamonds = saveData.Diamonds
        end
    end)

    pcall(function()
        local currentPetSlots = saveData.PetSlotsPurchased or saveData.EquipSlotsPurchased or 0
        local maxAllowedPet = 999
        if successRank and RankCmds and RankCmds.GetMaxPurchasableEquipSlots then
            maxAllowedPet = RankCmds.GetMaxPurchasableEquipSlots() or 999
        end
        if currentPetSlots >= maxAllowedPet then return end
        if (now - lastFailedPetSlotTime) < 60 and currentDiamonds <= lastFailedPetSlotDiamonds then
            return
        end

        local attempt = 0
        while currentPetSlots < maxAllowedPet and attempt < 5 do
            attempt = attempt + 1
            local targetSlot = currentPetSlots + 1
            local ok, res = pcall(function() return Network.Invoke("EquipSlotsMachine_RequestPurchase", targetSlot) end)
            if ok and res and res ~= false then
                print(string.format("[MapAuto:Slots] Purchased pet slot #%d", targetSlot))
                currentPetSlots = targetSlot
                lastFailedPetSlotDiamonds = -1
                task.wait(0.2)
            else
                lastFailedPetSlotTime = os.clock()
                lastFailedPetSlotDiamonds = currentDiamonds
                break
            end
        end
    end)

    pcall(function()
        local currentEggSlots = saveData.EggSlotsPurchased or saveData.EggHatchSlotsPurchased or 0
        local maxAllowedEgg = 999
        if successRank and RankCmds and RankCmds.GetMaxPurchasableEggSlots then
            maxAllowedEgg = RankCmds.GetMaxPurchasableEggSlots() or 999
        end
        if currentEggSlots >= maxAllowedEgg then return end
        if (now - lastFailedEggSlotTime) < 60 and currentDiamonds <= lastFailedEggSlotDiamonds then
            return
        end

        local attempt = 0
        while currentEggSlots < maxAllowedEgg and attempt < 10 do
            attempt = attempt + 1
            local targetBundleEnd = nil
            if successRank and RankCmds and RankCmds.GetEggBundle then
                pcall(function()
                    local v8 = RankCmds.GetEggBundle(currentEggSlots + 1)
                    if v8 then targetBundleEnd = v8 end
                end)
            end

            local candidateTargets = {}
            if targetBundleEnd then table.insert(candidateTargets, targetBundleEnd) end
            if targetBundleEnd ~= (currentEggSlots + 1) then
                table.insert(candidateTargets, currentEggSlots + 1)
            end

            local boughtAny = false
            for _, targetSlot in ipairs(candidateTargets) do
                local ok, res = pcall(function() return Network.Invoke("EggHatchSlotsMachine_RequestPurchase", targetSlot) end)
                if ok and res and res ~= false then
                    print(string.format("[MapAuto:Slots] Purchased egg slot #%d", targetSlot))
                    boughtAny = true
                    currentEggSlots = targetSlot
                    lastFailedEggSlotDiamonds = -1
                    task.wait(0.2)
                    break
                end
            end
            if not boughtAny then
                lastFailedEggSlotTime = os.clock()
                lastFailedEggSlotDiamonds = currentDiamonds
                break
            end
        end
    end)
end

local BestPotionManager = {}
local lastPotionUse = 0

function BestPotionManager.Step()
    if not getgenv().MapAutoConfig.AutoBestPotions then return end
    if os.clock() - lastPotionUse < 5 then return end
    lastPotionUse = os.clock()

    local saveData = Save.Get()
    if not saveData or not saveData.Inventory or not saveData.Inventory.Potion then return end

    local successPot, PotionCmds = pcall(function() return LoadModule(Client, "PotionCmds") end)
    local successMas, MasteryCmds = pcall(function() return LoadModule(Client, "MasteryCmds") end)

    local function CanDrinkTier(tier)
        if successMas and MasteryCmds and MasteryCmds.CanUsePotion then
            local ok, can = pcall(MasteryCmds.CanUsePotion, tier)
            if ok then return can == true end
        end
        return tier <= 7
    end

    local bestPotions = {}
    for uid, potData in pairs(saveData.Inventory.Potion) do
        local pType = potData.id or potData._id
        local pTier = tonumber(potData.tn or potData.tier or potData.t) or 1
        if pType and CanDrinkTier(pTier) then
            if not bestPotions[pType] or pTier > bestPotions[pType].tier then
                bestPotions[pType] = { uid = tostring(uid), tier = pTier }
            end
        end
    end

    local activePotions = nil
    if successPot and PotionCmds and PotionCmds.GetActivePotions then
        pcall(function() activePotions = PotionCmds.GetActivePotions() end)
    end

    for pType, pot in pairs(bestPotions) do
        local isActive = false
        if activePotions and activePotions[pType] and next(activePotions[pType]) ~= nil then
            isActive = true
        end

        if not isActive then
            pcall(function()
                Network.Fire("Potions: Consume", pot.uid, 1)
                print(string.format("[MapAuto:Potion] Used '%s' (Tier %d)", tostring(pType), pot.tier))
            end)
            task.wait(0.1)
        end
    end
end

local AutoFruitsManager = {}
local lastFruitCheck = 0

local function IsFruitActive(FruitCmds, fId)
    if not FruitCmds or not fId then return false end
    local active = false
    pcall(function()
        if FruitCmds.GetFruitData then
            local data = FruitCmds.GetFruitData(fId)
            if data and type(data) == "table" then
                local shinyCount = data.Shiny and #data.Shiny or 0
                local normalCount = data.Normal and #data.Normal or 0
                if (shinyCount + normalCount) > 0 then
                    active = true
                end
            end
        elseif FruitCmds.Has then
            local has = FruitCmds.Has(fId)
            if has then active = true end
        end
    end)
    return active
end

function AutoFruitsManager.Step()
    if not getgenv().MapAutoConfig.AutoFruits then return end
    if os.clock() - lastFruitCheck < 60 then return end
    lastFruitCheck = os.clock()

    local saveData = Save.Get()
