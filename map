local patches = {}
local disabledConns = {}
local function RegisterPatch(module, key, original)
    if module and key ~= nil then
        table.insert(patches, { module = module, key = key, original = original })
    end
end

local function SafePatch(tbl, key, newFunc)
    if not tbl or not key or not newFunc then return end
    pcall(function()
        if setreadonly then setreadonly(tbl, false) end
        if make_writeable then make_writeable(tbl) end
    end)
    local original = tbl[key]
    local success = pcall(function()
        tbl[key] = newFunc
    end)
    if success and original then
        RegisterPatch(tbl, key, original)
    end
end
