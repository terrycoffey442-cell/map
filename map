local function Teardown()
    for i = #connections, 1, -1 do
        pcall(function() connections[i]:Disconnect() end)
        connections[i] = nil
    end
    for i = #patches, 1, -1 do
        local p = patches[i]
        if p and p.module then
            pcall(function() p.module[p.key] = p.original end)
        end
        patches[i] = nil
    end
    for i = #disabledConns, 1, -1 do
        local c = disabledConns[i]
        pcall(function() if c and c.Enable then c:Enable() end end)
        disabledConns[i] = nil
    end
    pcall(function()
        RunService:Set3dRenderingEnabled(true)
    end)
    pcall(function()
        local sf = workspace:FindFirstChild("MapAuto_SafeFloor")
        if sf then sf:Destroy() end
