    farmModulesLoaded = true
end

local lastPetBulkSignature = ""
local lastPetBulkFire = 0
local tapRoundRobinCursor = 0
local lastTapFireTime = 0
local TAP_MIN_INTERVAL_S = 0.085

local function BreakablesSignature(list)
    local parts = {}
    for _, b in ipairs(list) do
        if b and b.uid then table.insert(parts, tostring(b.uid)) end
    end
    table.sort(parts)
    return table.concat(parts, ",")
end

function FarmManager.Step()
    if not getgenv().MapAutoConfig.AutoFarmBestZone then return end

    FarmEnsureModules()
    if not farmModules.ZoneCmds then return end

    local zoneName = GetBestFarmingZone()
    if not zoneName then return end

    FastTeleportToZoneCenter(zoneName)

    local breakables = GetBreakableList(zoneName)
    if not breakables or #breakables == 0 then return end

    table.sort(breakables, function(a, b) return tostring(a.uid) < tostring(b.uid) end)

    local root = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart
    local targetPos = zoneFieldPositionCache[zoneName]
    if root and targetPos and (root.Position - targetPos).Magnitude > 40 then return end

    local now = os.clock()

    if _G.SetMapAutoStatus then
        _G.SetMapAutoStatus(string.format("[Farm] Engaging %d breakables in '%s'...", #breakables, tostring(zoneName)), Color3.fromRGB(0, 255, 170))
    end

    local sig = BreakablesSignature(breakables)
    local assignedPetCount = 0
    if sig ~= lastPetBulkSignature or (now - lastPetBulkFire) > 1.5 then
        pcall(function()
            local PlayerPetMod = farmModules.PlayerPet
            local petsDict = (PlayerPetMod and PlayerPetMod.GetByPlayer and PlayerPetMod.GetByPlayer(LocalPlayer))
            if type(petsDict) == "table" and #breakables > 0 then
                local petList = {}
                for euidKey, petObj in pairs(petsDict) do
                    if type(petObj) == "table" then
                        table.insert(petList, { euid = tostring(petObj.euid or euidKey), pet = petObj })
                    end
                end
                table.sort(petList, function(a, b) return a.euid < b.euid end)

                if #petList > 0 then
                    local petBulk = {}
                    for i, entry in ipairs(petList) do
                        local targetBreakable = breakables[((i - 1) % #breakables) + 1]
                        if targetBreakable and targetBreakable.uid then
                            petBulk[entry.euid] = tostring(targetBreakable.uid)
                            assignedPetCount = assignedPetCount + 1
                            if targetBreakable.model and targetBreakable.model.Parent then
                                pcall(function()
                                    if type(entry.pet.SetTarget) == "function" then
                                        entry.pet:SetTarget(targetBreakable.model)
                                    end
                                end)
                            end
                        end
                    end
                    if next(petBulk) then
                        Network.Fire("Breakables_JoinPetBulk", petBulk)
                        lastPetBulkSignature = sig
                        lastPetBulkFire = now
                    end
                end
            end
        end)
    end

    pcall(function()
        local numBreakables = #breakables
        if numBreakables == 0 then return end

        local function FireNextValidTap()
            if not Running() then return end
            for _ = 1, numBreakables do
                tapRoundRobinCursor = (tapRoundRobinCursor % numBreakables) + 1
                local b = breakables[tapRoundRobinCursor]
                if b and b.uid then
                    local model = b.model
                    if (not model) or (model.Parent ~= nil) then
                        Network.UnreliableFire("Breakables_PlayerDealDamage", b.uid)
                        lastTapFireTime = os.clock()
                        return
                    end
                end
            end
        end

        if (now - lastTapFireTime) >= TAP_MIN_INTERVAL_S then
            FireNextValidTap()
        end
        task.delay(0.09, FireNextValidTap)
        task.delay(0.18, FireNextValidTap)
    end)

    if now - lastFarmDebugTime > 8 then
        lastFarmDebugTime = now
        local charPos = (root and root.Position) or Vector3.new(0, 0, 0)
        local targetUid = breakables[1] and breakables[1].uid or "none"
        print(string.format("[MapAuto:Farm] Zone: '%s' | Breakables: %d | Target: %s | Pos: (%.1f, %.1f, %.1f)", tostring(zoneName), #breakables, tostring(targetUid), charPos.X, charPos.Y, charPos.Z))
    end
end

