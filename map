local lastWorldTransitionAttempt = 0

local WorldTransitionManager = {}
function WorldTransitionManager.Step()
    if not getgenv().MapAutoConfig.AutoFarmBestZone then return end
    if os.clock() - lastWorldTransitionAttempt < 30 then return end

    local sd = Save.Get()
    if not sd then return end

    local maxZone, maxZoneData = ZoneCmds.GetMaxOwnedZone()
    if not maxZone then return end

    local maxNum = maxZoneData and maxZoneData.ZoneNumber
    if not maxNum then
        local zDef = Directory and Directory.Zones and Directory.Zones[maxZone]
        maxNum = zDef and zDef.ZoneNumber or 0
    end

    local successWorlds, WorldsUtil = pcall(function() return LoadModule(Library:WaitForChild("Util"), "WorldsUtil") end)
    local currentWorldNum = 1
    pcall(function()
        if successWorlds and WorldsUtil then
            if type(WorldsUtil.GetWorldNumber) == "function" then
                currentWorldNum = WorldsUtil.GetWorldNumber() or 1
            elseif type(WorldsUtil.GetWorldOrDefault) == "function" then
                local w = WorldsUtil.GetWorldOrDefault()
                if w and w.WorldNumber then currentWorldNum = w.WorldNumber end
            end
        end
    end)

    if currentWorldNum <= 1 then
        local zoneLower = string.lower(maxZone)
        if string.find(zoneLower, "fantasy", 1, true) or string.find(zoneLower, "doodle", 1, true) then
            currentWorldNum = 4
        elseif string.find(zoneLower, "void", 1, true) or maxNum >= 200 then
            if maxNum >= 300 then currentWorldNum = 4
            else currentWorldNum = 3 end
        elseif string.find(zoneLower, "tech", 1, true) or maxNum >= 100 then
            if maxNum >= 200 then currentWorldNum = 3
            else currentWorldNum = 2 end
        end
    end

    local targetWorld = nil
    if maxNum >= 300 or sd.HasDoneWorld4Teleport then
        targetWorld = 4
    elseif maxNum >= 200 or sd.HasDoneWorld3Teleport then
        targetWorld = 3
    elseif maxNum >= 100 or sd.HasDoneWorld2Teleport then
        targetWorld = 2
    end

    if not targetWorld or targetWorld <= currentWorldNum then return end

    lastWorldTransitionAttempt = os.clock()
    print(string.format("[MapAuto:World] Max zone '%s' (#%d) requires World %d (current: %d), teleporting",
        maxZone, maxNum, targetWorld, currentWorldNum))

    pcall(function()
        local TeleportMapCmds = LoadModule(Client, "TeleportMapCmds")
        if TeleportMapCmds and TeleportMapCmds.TeleportWorlds then
            TeleportMapCmds.TeleportWorlds(targetWorld)
        end
    end)
end

task.spawn(function()
    while Running() do
        task.wait(10)
        if not Running() then break end
        safeCall("WorldTransitionManager", WorldTransitionManager.Step)
    end
end)

