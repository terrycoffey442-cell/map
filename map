local function IsBossOrNonFarmInstance(inst)
    if not inst then return true end
    local name = string.lower(inst.Name)
    if string.find(name, "boss", 1, true)
        or string.find(name, "chest", 1, true)
        or string.find(name, "particle", 1, true)
        or string.find(name, "hvn", 1, true)
        or string.find(name, "giant", 1, true)
        or string.find(name, "big", 1, true)
        or string.find(name, "vip", 1, true)
        or string.find(name, "event", 1, true)
        or string.find(name, "door", 1, true)
        or string.find(name, "gate", 1, true)
        or string.find(name, "portal", 1, true)
    then
        return true
    end
    return false
end

local function IsBossBreakable(bModel, bUID)
    if not bModel then return false end
    local name = string.lower(bModel.Name)
    if string.find(name, "boss", 1, true) or string.find(name, "giant", 1, true) or string.find(name, "underworld chest", 1, true) or string.find(name, "heaven gates chest", 1, true) or string.find(name, "cyber chest", 1, true) then
        return true
    end

    local isBossDef = false
    pcall(function()
        if Directory and Directory.Breakables then
            local def = Directory.Breakables[bModel.Name] or (bUID and Directory.Breakables[bUID])
            if def and (def.IsBoss == true or def.boss == true or def.IsBossChest == true or def.Class == "Boss") then
                isBossDef = true
            end
        end
    end)
    return isBossDef
end

