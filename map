local loadedModuleCache = {}
local function LoadModule(parent, moduleName)
    if not parent or not moduleName then
        warn(string.format("[MapAuto:Loader] Parent nil for '%s'", tostring(moduleName)))
        return nil
    end
    local parentCache = loadedModuleCache[parent]
    if parentCache and parentCache[moduleName] ~= nil then
        return parentCache[moduleName] or nil
    end
    local target = parent:FindFirstChild(moduleName)
    if not target then
        local okFind = pcall(function()
            target = parent:WaitForChild(moduleName, 10)
        end)
        if not okFind or not target then
            if not parentCache then
                parentCache = {}
                loadedModuleCache[parent] = parentCache
            end
            parentCache[moduleName] = false
            warn(string.format("[MapAuto:Loader] '%s' not found under %s", tostring(moduleName), tostring(parent.Name)))
            return nil
        end
    end
    local okReq, mod = pcall(require, target)
    if not okReq then
        warn(string.format("[MapAuto:Loader] Require failed for '%s': %s", tostring(moduleName), tostring(mod)))
        return nil
    end
    if not parentCache then
        parentCache = {}
        loadedModuleCache[parent] = parentCache
    end
    parentCache[moduleName] = mod
    return mod
end

