local function FormatTime(seconds)
    seconds = math.max(0, tonumber(seconds) or 0)
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

local function FindDashboardParent()
    local pg = LocalPlayer and (LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5))
    if pg then
        if pg:FindFirstChild("Kaitun_Dashboard_UI") then pcall(function() pg["Kaitun_Dashboard_UI"]:Destroy() end) end
        return pg
    end
    local ok, cg = pcall(function() return (cloneref and cloneref(game:GetService("CoreGui"))) or game:GetService("CoreGui") end)
    if ok and cg then
        if cg:FindFirstChild("Kaitun_Dashboard_UI") then pcall(function() cg["Kaitun_Dashboard_UI"]:Destroy() end) end
        return cg
    end
    return nil
end

local function UpdateDashboardStep()
    if not kaitunLabels or not kaitunLabels.Time then return end

    pcall(function()
        local saveData = Save.Get()
        if not saveData then return end

        local uptimeStr = FormatTime(os.time() - scriptStartTime)
        if kaitunLabels.Time then
            kaitunLabels.Time.Text = "Session Time: " .. uptimeStr
        end

        local diamonds = 0
        if CurrencyCmds and CurrencyCmds.Get then
            diamonds = CurrencyCmds.Get("Diamonds") or 0
        elseif saveData.Diamonds then
            diamonds = saveData.Diamonds
        elseif saveData.Inventory and saveData.Inventory.Currency and saveData.Inventory.Currency.Diamonds then
            diamonds = saveData.Inventory.Currency.Diamonds._am or 0
        end

        local currentRank = saveData.Rank or 1
        local rankId = RanksUtil.RankIDFromNumber(currentRank)
        local rankData = rankId and Directory.Ranks and Directory.Ranks[rankId]
        local rankTitle = (rankData and (rankData.RankTitle or rankData.Title)) or ("Rank " .. tostring(currentRank))
        local rebirthCount = saveData.Rebirths or (RebirthCmds and RebirthCmds.Get and RebirthCmds.Get()) or 0

        if kaitunLabels.Coins then
            kaitunLabels.Coins.Text = string.format("Diamonds: %s  |  Rank: %d (%s)  |  Rebirth: %d", FormatCompactNumber(diamonds), currentRank, tostring(rankTitle), rebirthCount)
        end

        local petSlots = saveData.MaxPetsEquipped or 4
        pcall(function()
            if PetCmds and PetCmds.GetMaxEquipped then
                petSlots = PetCmds.GetMaxEquipped()
            end
        end)

        local eggSlots = saveData.EggHatchCount or 1
        pcall(function()
            local successEgg, EggCmds = pcall(function() return LoadModule(Client, "EggCmds") end)
            if successEgg and EggCmds and EggCmds.GetMaxHatch then
                eggSlots = EggCmds.GetMaxHatch()
            end
        end)

        if kaitunLabels.Slots then
            kaitunLabels.Slots.Text = string.format("Pet Slots: %d  |  Egg Hatch Slots: %d", petSlots, eggSlots)
        end

        local currentZone = "Unknown"
        pcall(function()
            local successZone, ZoneCmds = pcall(function() return LoadModule(Client, "ZoneCmds") end)
            if successZone and ZoneCmds and ZoneCmds.GetMaxOwnedZone then
                currentZone = ZoneCmds.GetMaxOwnedZone()
            end
        end)
        if kaitunLabels.Zone then
            kaitunLabels.Zone.Text = "Current Zone: " .. tostring(currentZone)
        end

        if kaitunLabels.Status then
            kaitunLabels.Status.Text = "Status: " .. tostring(currentStatusText)
        end
    end)
end

